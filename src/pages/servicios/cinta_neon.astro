---
import Layout from '../../layouts/Layout.astro'

const BASE = import.meta.env.BASE_URL

const base =
  BASE === '/'
    ? '/assets/services/cinta-neon'
    : '/victoranuncios-web/assets/services/cinta-neon'

const trabajos = [
  {
    titulo: 'Diseño Artístico con Marco',
    desc: 'Ilustración personalizada con marco acrílico transparente y neón LED rojo intenso. Ideal para decoración de interiores, oficinas creativas o espacios modernos.',
    img: `${base}/neon1.webp`,
    tags: ['Marco Acrílico', 'Neón LED Rojo', 'Arte Premium', 'Diseño Personalizado'],
  },
  {
    titulo: 'Letrero Comercial Multicolor',
    desc: 'Diseño vibrante para negocio de comida con ilustración de personaje y texto en neón LED multicolor. Combina rosa, azul y tonos cálidos para máximo impacto visual.',
    img: `${base}/neon2.webp`,
    tags: ['Multicolor', 'Rosa + Azul + Amarillo', 'Negocios', 'Alto Impacto'],
  },
]

const beneficios = [
  {
    icono: '⚡',
    titulo: 'Bajo Consumo',
    desc: 'Ahorra energía frente a sistemas tradicionales.',
  },
  {
    icono: '🛡️',
    titulo: 'Más Seguro',
    desc: 'No usa gases ni vidrio frágil.',
  },
  {
    icono: '⭐',
    titulo: 'Duradero',
    desc: 'Hasta 50,000 horas de vida útil.',
  },
  {
    icono: '💡',
    titulo: 'Sin Calor',
    desc: 'Permanece frío al tacto.',
  },
]

const colores = [
  'Rojo',
  'Azul',
  'Verde',
  'Amarillo',
  'Rosa',
  'Naranja',
  'Morado',
  'Blanco',
  'Multicolor',
]

const idealPara = [
  'Bares y restaurantes',
  'Tiendas y boutiques',
  'Salones de belleza',
  'Cafeterías y heladerías',
  'Discotecas y eventos',
  'Oficinas modernas',
  'Estudios y agencias',
  'Decoración de interiores',
]

const tecnicas = [
  {
    titulo: 'Tecnología LED',
    items: [
      'Luces LED de alta calidad',
      'Vida útil: 50,000 horas',
      'Consumo: 12V bajo voltaje',
      'Brillo ajustable disponible',
    ],
  },
  {
    titulo: 'Fabricación',
    items: [
      'Base acrílica transparente o sólida',
      'Tubo flexible LED neón',
      'Diseño 100% personalizado',
      'Garantía 1 año',
    ],
  },
  {
    titulo: 'Instalación',
    items: [
      'Incluye transformador',
      'Montaje en pared o colgante',
      'Instalación profesional',
      'Cable de alimentación',
    ],
  },
]
---

<Layout
  title="Letreros en neón LED en Arequipa | Victor Anuncios"
  description="Letreros en neón LED personalizados en Arequipa. Diseño, fabricación e instalación para negocios, restaurantes, bares, tiendas y decoración."
  keywords="letreros neon Arequipa, neon led Arequipa, cinta neon, letreros led, Victor Anuncios"
  canonical="https://victoranuncios.com/servicios/cinta-neon/"
>
  <!-- HERO -->
  <section class="relative min-h-[86vh] overflow-hidden text-white bg-[#13051f]">
    <div class="absolute inset-0">
      <img
        src={`${base}/hero-neon.webp`}
        alt="Letreros en neón LED Victor Anuncios"
        class="h-full w-full object-cover opacity-35"
      />
      <div class="absolute inset-0 bg-gradient-to-br from-pink-700/85 via-purple-800/85 to-blue-900/90"></div>
      <div class="absolute inset-0 bg-black/20"></div>
    </div>

    <div class="relative max-w-[1180px] mx-auto px-6 pt-24 pb-20 text-center">
      <div class="inline-flex items-center gap-2 px-5 py-2 bg-white/10 border border-white/20 text-white/90 text-xs font-bold uppercase tracking-wide">
        ✨ Iluminación LED
      </div>

      <h1 class="mt-8 text-5xl md:text-7xl font-black leading-tight uppercase">
        Letreros en <br />
        <span class="text-pink-200">Neón LED</span>
      </h1>

      <p class="mt-7 max-w-2xl mx-auto text-lg md:text-xl text-white/90 leading-relaxed">
        Neón LED moderno y vibrante para tu negocio. Bajo consumo, larga duración
        y colores espectaculares. Diseño personalizado + instalación incluida.
      </p>

      <div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="https://wa.me/51946182531?text=Hola%20Victor,%20quiero%20cotizar%20un%20letrero%20en%20neon%20LED"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 bg-white text-pink-600 font-black px-7 py-4 rounded-xl shadow-xl hover:scale-[1.03] transition"
        >
          ☎ Cotizar - 946 182 531
        </a>

        <a
          href="#trabajos"
          class="inline-flex items-center justify-center gap-2 bg-white/10 border border-white/40 text-white font-black px-7 py-4 rounded-xl hover:bg-white/20 transition"
        >
          Ver Galería →
        </a>
      </div>

      <div class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-3xl mx-auto">
        <div class="bg-white/10 border border-white/20 px-5 py-4 text-left">
          <p class="font-black">⚡ Bajo Consumo</p>
          <p class="text-sm text-white/75">Ahorra energía</p>
        </div>
        <div class="bg-white/10 border border-white/20 px-5 py-4 text-left">
          <p class="font-black">⭐ Larga Duración</p>
          <p class="text-sm text-white/75">Hasta 50,000 hrs</p>
        </div>
        <div class="bg-white/10 border border-white/20 px-5 py-4 text-left">
          <p class="font-black">✨ Colores Vibrantes</p>
          <p class="text-sm text-white/75">9 colores disponibles</p>
        </div>
      </div>
    </div>
  </section>

  <main class="bg-white">
    <!-- BENEFICIOS -->
    <section class="max-w-[1180px] mx-auto px-6 py-20">
      <div class="text-center">
        <span class="inline-block bg-pink-100 text-pink-600 px-5 py-2 text-xs font-black uppercase">
          Neón LED moderno
        </span>

        <h2 class="mt-5 text-4xl md:text-5xl font-black text-slate-900">
          ¿Por Qué Elegir Neón LED?
        </h2>

        <p class="mt-4 text-lg text-slate-600">
          Tecnología LED que supera al neón tradicional
        </p>
      </div>

      <div class="mt-14 grid grid-cols-1 md:grid-cols-4 gap-6">
        {beneficios.map((b) => (
          <article class="reveal bg-white border-t-4 border-pink-500 shadow-xl p-8 hover:-translate-y-1 transition">
            <div class="h-14 w-14 flex items-center justify-center text-2xl bg-gradient-to-br from-pink-600 to-purple-700 text-white">
              {b.icono}
            </div>
            <h3 class="mt-7 text-xl font-black text-slate-900">{b.titulo}</h3>
            <p class="mt-3 text-slate-600 leading-relaxed">{b.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- TRABAJOS -->
    <section id="trabajos" class="max-w-[1180px] mx-auto px-6 py-16">
      <div class="text-center">
        <span class="inline-block bg-pink-100 text-pink-600 px-5 py-2 text-xs font-black uppercase">
          Nuestro portafolio
        </span>

        <h2 class="mt-5 text-4xl md:text-5xl font-black text-slate-900">
          Trabajos en Neón LED
        </h2>

        <p class="mt-4 text-lg text-slate-600">
          Diseños personalizados en neón LED de alta calidad
        </p>
      </div>

      <div class="mt-14 space-y-14">
        {trabajos.map((t, index) => (
          <article class="reveal max-w-[920px] mx-auto overflow-hidden shadow-2xl bg-white">
            <div class={index === 1 ? 'bg-gradient-to-br from-purple-700 to-pink-700 p-8' : 'bg-slate-950 p-8'}>
              <img
                src={t.img}
                alt={t.titulo}
                class="w-full max-h-[760px] object-cover mx-auto"
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="bg-pink-50 border-l-4 border-pink-500 p-8">
              <h3 class="text-2xl font-black text-slate-900">{t.titulo}</h3>
              <p class="mt-4 text-slate-700 text-lg leading-relaxed">{t.desc}</p>

              <div class="mt-6 flex flex-wrap gap-3">
                {t.tags.map((tag) => (
                  <span class="border border-pink-200 bg-pink-50 text-pink-600 px-4 py-2 text-sm font-black">
                    ✓ {tag}
                  </span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="reveal mt-16 max-w-[820px] mx-auto text-center border-t-4 border-pink-500 bg-gradient-to-br from-pink-50 to-blue-50 p-10">
        <h3 class="text-2xl font-black text-slate-900">
          Diseños Únicos en Neón LED
        </h3>

        <p class="mt-5 text-lg text-slate-700 leading-relaxed">
          Desde diseños artísticos hasta letreros comerciales vibrantes. Creamos
          neón LED personalizado para tu negocio, bar, restaurante o decoración.
          Colores únicos, brillantes y duraderos.
        </p>
      </div>

      <div class="mt-10 text-center">
        <p class="text-xl font-black text-slate-900">
          ¿Tienes una idea para tu letrero en neón?
        </p>

        <a
          href="https://wa.me/51946182531?text=Hola%20Victor,%20quiero%20solicitar%20un%20dise%C3%B1o%20personalizado%20en%20neon%20LED"
          target="_blank"
          rel="noopener"
          class="mt-6 inline-flex items-center justify-center gap-2 bg-gradient-to-r from-pink-600 to-purple-700 text-white font-black px-8 py-4 rounded-xl shadow-xl hover:scale-[1.03] transition"
        >
          ☎ Solicitar Diseño Personalizado
        </a>
      </div>
    </section>

    <!-- COLORES -->
    <section class="bg-slate-50 py-20">
      <div class="max-w-[1180px] mx-auto px-6 text-center">
        <h2 class="text-4xl md:text-5xl font-black text-slate-900">
          Colores Disponibles
        </h2>

        <p class="mt-4 text-lg text-slate-600">
          Elige el color que mejor represente tu marca
        </p>

        <div class="mt-12 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-9 gap-4">
          {colores.map((color) => (
            <div class="reveal bg-white shadow-lg p-5 hover:-translate-y-1 transition">
              <div class="mx-auto h-14 w-14 rounded-full border-4 border-slate-200 flex items-center justify-center text-xl">
                💡
              </div>
              <p class="mt-4 font-black text-slate-900 text-sm">{color}</p>
            </div>
          ))}
        </div>

        <p class="mt-8 text-slate-700">
          💡 <strong>¿Necesitas un color específico?</strong> Podemos conseguirlo
        </p>
      </div>
    </section>

    <!-- IDEAL PARA -->
    <section class="max-w-[980px] mx-auto px-6 py-20">
      <h2 class="text-center text-4xl md:text-5xl font-black text-slate-900">
        Ideal Para
      </h2>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-5">
        {idealPara.map((item) => (
          <div class="reveal bg-white shadow-lg border-l-4 border-pink-500 px-7 py-5 flex items-center gap-4">
            <span class="text-pink-500 text-2xl">✣</span>
            <p class="font-black text-slate-900">{item}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CARACTERÍSTICAS -->
    <section class="bg-slate-50 py-20">
      <div class="max-w-[1100px] mx-auto px-6">
        <h2 class="text-center text-4xl md:text-5xl font-black text-slate-900">
          Características Técnicas
        </h2>

        <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
          {tecnicas.map((card) => (
            <article class="reveal bg-pink-50 border-t-4 border-pink-500 shadow-xl p-8">
              <h3 class="text-2xl font-black text-slate-900">{card.titulo}</h3>

              <ul class="mt-6 space-y-4">
                {card.items.map((item) => (
                  <li class="flex gap-3 text-slate-700">
                    <span class="text-pink-600 font-black">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="relative overflow-hidden bg-gradient-to-br from-slate-950 via-pink-900 to-purple-900 text-white py-24">
      <div class="relative max-w-[900px] mx-auto px-6 text-center">
        <div class="text-5xl text-pink-300">✦</div>

        <h2 class="mt-8 text-4xl md:text-5xl font-black leading-tight">
          Ilumina Tu Negocio <br />
          Con Estilo Neón
        </h2>

        <p class="mt-7 text-xl text-white/90">
          Cotiza tu letrero en neón LED personalizado hoy. <br />
          <strong>Diseño e instalación incluidos.</strong>
        </p>

        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="https://wa.me/51946182531?text=Hola%20Victor,%20quiero%20cotizar%20un%20letrero%20en%20neon%20LED"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center gap-2 bg-white text-pink-600 font-black px-8 py-4 rounded-xl shadow-xl hover:scale-[1.03] transition"
          >
            ☎ WhatsApp: 946 182 531
          </a>

          <a
            href="/servicios/"
            class="inline-flex items-center justify-center gap-2 bg-white/10 border border-white/40 text-white font-black px-8 py-4 rounded-xl hover:bg-white/20 transition"
          >
            Ver Todos los Servicios →
          </a>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    ;(() => {
      const els = document.querySelectorAll('.reveal')
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) e.target.classList.add('is-visible')
          })
        },
        { threshold: 0.12 }
      )
      els.forEach((el) => io.observe(el))
    })()
  </script>

  <style is:global>
    .reveal {
      opacity: 0;
      transform: translateY(18px);
      transition:
        opacity 700ms ease,
        transform 700ms ease;
      will-change: opacity, transform;
    }

    .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      .reveal,
      .reveal.is-visible {
        transition: none !important;
        transform: none !important;
        opacity: 1 !important;
      }
    }
  </style>
</Layout>
