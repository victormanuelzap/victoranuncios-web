---
import Layout from '../../layouts/Layout.astro'

// Usar la base correcta para local y GitHub Pages
const BASE = import.meta.env.BASE_URL

const base =
  BASE === '/'
    ? '/assets/services/letrero-luminoso'
    : '/victoranuncios-web/assets/services/letrero-luminoso'

// Imágenes del catálogo
const images = [
  'img-1.png',
  'img-2.png',
  'img-3.png',
  'img-4.png',
  'img-5.png',
  'img-6.png',
  'img-7.png',
  'img-8.png',
  'img-9.png',
  'img-10.png',
]

// Tarjetas con descripción (3 proyectos reales)
const tipos = [
  {
    slug: 'chifa-perla',
    titulo: 'CHIFA LA PERLA ORIENTAL 🔆',
    img: `${base}/chifa-perla-oriental.png`,
    alt: 'Letrero luminoso Chifa La Perla Oriental en Arequipa',
    bullets: [
      'Letrero luminoso rectangular de gran formato',
      'Estructura reforzada con tubo galvanizado',
      'Impresión en lona backlight de alta resolución',
      'Iluminación LED uniforme para gran visibilidad',
      'Instalación completa en fachada y columna',
      'Garantía: 1 año',
    ],
    waText:
      'Hola%20quiero%20cotizar%20un%20letrero%20luminoso%20como%20el%20de%20Chifa%20La%20Perla%20Oriental',
  },
  {
    slug: 'polleria-gomez',
    titulo: 'POLLERÍA LOS GÓMEZ 🍗',
    img: `${base}/polleria-los-gomez.png`,
    alt: 'Letrero luminoso Pollería Los Gómez en Arequipa',
    bullets: [
      'Letrero luminoso frontal con luz LED interna',
      'Lona backlight full color con diseño profesional',
      'Marco metálico reforzado',
      'Iluminación LED de bajo consumo',
      'Instalación a medida en fachada',
      'Garantía: 1 año',
    ],
    waText:
      'Hola%20quiero%20cotizar%20un%20letrero%20luminoso%20como%20el%20de%20Polleria%20Los%20Gomez',
  },
  {
    slug: 'doble-faz',
    titulo: 'LETRERO LUMINOSO DOBLE FAZ 🔄',
    img: `${base}/caja-azul.png`,
    alt: 'Letrero luminoso doble faz azul en Arequipa',
    bullets: [
      'Letrero luminoso doble faz',
      'Estructura metálica reforzada',
      'Lona backlight a ambos lados',
      'Iluminación LED interna de alta potencia',
      'Ideal para esquinas y exteriores',
      'Garantía: 1 año',
    ],
    waText:
      'Hola%20quiero%20cotizar%20un%20letrero%20luminoso%20doble%20faz%20como%20el%20azul',
  },
]
---

<Layout
  title="Letreros luminosos en Arequipa – Fabricación e instalación | Victor Anuncios"
  description="Fabricamos e instalamos letreros luminosos y cajas de luz LED en Arequipa. Diseño profesional, estructuras reforzadas y entrega rápida."
  keywords="letreros luminosos Arequipa, cajas de luz Arequipa, letreros LED Arequipa, publicidad exterior Arequipa"
  canonical="https://victoranuncios.com/servicios/letrero-luminoso"
>
  <!-- HERO DE LETRERO LUMINOSO -->
  <section class="relative">
    <img
      src={`${base}/hero-luminoso.jpg`}
      alt="Letrero luminoso Victor Anuncios"
      class="h-80 md:h-[420px] w-full object-cover"
      loading="eager"
    />
    <!-- CAPA OSCURA -->
    <div class="absolute top-0 left-0 w-full h-full bg-black bg-opacity-50 flex justify-center items-center">
      <h1 class="text-white text-4xl md:text-6xl font-bold uppercase text-center">
        LETRERO LUMINOSO
      </h1>
    </div>
    <!-- DEGRADADO HACIA BLANCO -->
    <div class="absolute bottom-0 left-0 w-full h-24 bg-gradient-to-b from-transparent to-white"></div>
  </section>

  <main class="container mx-auto px-4 pt-10 pb-16">
    <!-- Badges -->
    <div class="flex flex-wrap items-center justify-center gap-3 mb-10">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gray-100 text-gray-700 text-sm">
        ✅ Garantía 1 año
      </span>
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gray-100 text-gray-700 text-sm">
        ✍️ Diseño + instalación
      </span>
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gray-100 text-gray-700 text-sm">
        ⚡ Entrega rápida
      </span>
    </div>

    <!-- CATÁLOGO: SOLO FOTOS -->
    <section aria-labelledby="catalogo-luminosos" class="mt-2">
      <h2 id="catalogo-luminosos" class="text-2xl md:text-3xl font-bold text-center mb-8">
        Catálogo
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 md:gap-4">
        {images.map((file, i) => (
          <figure class="relative aspect-square overflow-hidden rounded-xl bg-gray-100">
            <img
              src={`${base}/${file}`}
              alt={`Caja de luz / letrero luminoso modelo ${i + 1} - Victor Anuncios Arequipa`}
              loading={i < 4 ? 'eager' : 'lazy'}
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-200 hover:scale-105"
            />
          </figure>
        ))}
      </div>
    </section>

    <!-- TIPOS DE LETREROS (CON DESCRIPCIÓN) -->
    <section class="mt-14">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-8">
        Tipos de letreros luminosos
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {tipos.map((t) => (
          <article class="text-center bg-white rounded-2xl shadow-md p-4 md:p-6">
            <div class="relative w-full h-56 mb-4">
              <img
                src={t.img}
                alt={t.alt}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover rounded-xl shadow-sm"
              />
            </div>

            <h3 class="text-xl font-extrabold text-black leading-tight mb-2">
              {t.titulo}
            </h3>

            <ul class="text-left text-gray-700 space-y-1 mb-5">
              {t.bullets.map((b) => (
                <li>• {b}</li>
              ))}
            </ul>

            <!-- BOTÓN DE TARJETA EN AZUL -->
            <a
              href={`https://wa.me/51946182531?text=${t.waText}`}
              target="_blank"
              rel="noopener"
              class="inline-block bg-blue-600 hover:bg-blue-500 text-white font-bold px-6 py-2 rounded-lg transition"
            >
              Pedir por WhatsApp
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="mt-12">
      <div class="rounded-2xl bg-blue-600 text-white p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-4 md:gap-6">
        <p class="text-lg md:text-xl font-semibold text-center md:text-left">
          ¿Quieres un letrero como estos? Diseño + fabricación + instalación.
        </p>
        <!-- BOTÓN CTA FINAL (BLANCO PARA CONTRASTE) -->
        <a
          href="https://wa.me/51946182531?text=Quiero%20un%20letrero%20luminoso"
          class="px-5 py-3 bg-white text-blue-700 rounded-lg font-bold whitespace-nowrap hover:bg-gray-100 transition"
          rel="noopener"
        >
          Pedir por WhatsApp
        </a>
      </div>
    </section>

    <!-- TEXTO SEO PARA LETRERO LUMINOSO -->
    <section class="max-w-4xl mx-auto mb-10 text-gray-800 space-y-4">
      <h2 class="text-2xl md:text-3xl font-bold text-center md:text-left">
        Letreros luminosos para tu negocio en Arequipa
      </h2>

      <p>
        En <strong>Victor Anuncios</strong> fabricamos <strong>letreros luminosos y cajas de luz en Arequipa</strong> ideales para
        bodegas, farmacias, restaurantes, pollerías, ferreterías y todo tipo de negocios que necesitan ser visibles de día
        y de noche. Diseñamos cada letrero a medida según tu logo, colores y fachada.
      </p>

      <p>
        Trabajamos con <strong>estructuras de fierro reforzado</strong> y <strong>iluminación LED</strong> para lograr un letrero
        luminoso que consuma poca energía y que se vea profesional por muchos años. También te asesoramos en el tamaño y
        ubicación para que tu negocio se vea desde lejos y destaque frente a la competencia.
      </p>

      <h3 class="text-xl md:text-2xl font-semibold mt-4">
        ¿Por qué hacer tu letrero luminoso con Victor Anuncios?
      </h3>

      <ul class="list-disc list-inside space-y-1">
        <li>
          <strong>Diseño personalizado</strong> según tu rubro y tu marca.
        </li>
        <li>
          <strong>Estructuras seguras</strong>, con soportes y anclajes para fachadas y esquinas.
        </li>
        <li>
          <strong>Iluminación LED</strong> de bajo consumo y alta luminosidad.
        </li>
        <li>
          <strong>Fabricación e instalación en Arequipa</strong>, sin intermediarios.
        </li>
        <li>
          <strong>Garantía de 1 año</strong> en la estructura e iluminación.
        </li>
      </ul>

      <h3 class="text-xl md:text-2xl font-semibold mt-4">
        ¿Cuánto cuesta un letrero luminoso en Arequipa?
      </h3>

      <p>
        El precio de un <strong>letrero luminoso</strong> depende del tamaño, el tipo de estructura y la cantidad de iluminación LED
        que necesite. Podemos fabricar desde letreros pequeños para interiores hasta cajas de luz grandes para fachadas
        principales. Escríbenos por WhatsApp y te armamos una cotización según las medidas de tu local.
      </p>

      <p class="font-semibold">
        Envíanos una foto de tu fachada y las medidas aproximadas y te ayudamos a elegir el mejor tipo de letrero luminoso
        para tu negocio en Arequipa.
      </p>
    </section>
  </main>
</Layout>
