---
import Layout from '../../layouts/Layout.astro'

const BASE = import.meta.env.BASE_URL
const base = `${BASE}assets/services/vinilos`
const number = '51946182531'

const vinylTypes = [
  {
    title: 'Vinilo vehicular',
    subtitle: 'Motocar para helados artesanales',
    image: `${base}/vinilo-vehicular-helados.webp`,
    bullets: [
      'Rotulación completa o parcial de motocarros y motos',
      'Ideal para productos de alta rotación como helados y bebidas',
      'Hace que tu marca se vea en cada recorrido por la ciudad',
    ],
    whatsappText: 'Hola, quiero cotizar vinilo vehicular para motocar o moto',
  },
  {
    title: 'Vinilo vehicular',
    subtitle: 'Camión de reparto de gas',
    image: `${base}/vinilo-vehicular-solgas.webp`,
    bullets: [
      'Vinilo impreso de gran formato para camiones y furgones',
      'Comunica tu marca y tus servicios a gran distancia',
      'Resistente al sol y a la intemperie',
    ],
    whatsappText: 'Hola, quiero cotizar vinilo para camión o furgón',
  },
  {
    title: 'Vinilo impreso mural',
    subtitle: 'Restaurante El Gran Combo (mural 1)',
    image: `${base}/vinilo-impreso-restaurant-1.webp`,
    bullets: [
      'Fondos completos para paredes de restaurantes y negocios',
      'Ayuda a crear ambiente y refuerza la identidad del local',
      'Impresión en alta resolución a full color',
    ],
    whatsappText: 'Hola, quiero cotizar vinilo mural para restaurante',
  },
  {
    title: 'Vinilo impreso mural',
    subtitle: 'Restaurante El Gran Combo (mural 2)',
    image: `${base}/vinilo-impreso-restaurant-2.webp`,
    bullets: [
      'Murales decorativos con cartas e imágenes de productos',
      'Ideal para restaurantes, cafeterías y cevicherías',
      'Instalación limpia y sin burbujas',
    ],
    whatsappText: 'Hola, quiero cotizar vinilo mural decorativo para mi negocio',
  },
  {
    title: 'Vinilo impreso para mostradores',
    subtitle: 'Mostrador de atención Bitel',
    image: `${base}/vinilo-impreso-bitel.webp`,
    bullets: [
      'Revestimiento de mostradores, islas y módulos de atención',
      'Perfecto para promociones y campañas de operadoras o retail',
      'Aprovecha cada superficie de tu local para hacer publicidad',
    ],
    whatsappText: 'Hola, quiero cotizar vinilo para mostrador o módulo de atención',
  },
]
---

<Layout
  title="Vinilos personalizados en Arequipa | Victor Anuncios"
  description="Diseño, impresión e instalación de vinilos publicitarios en Arequipa: vinilo vehicular, murales para restaurantes y mostradores comerciales. Trabajos reales realizados por Victor Anuncios."
  keywords="vinilos Arequipa, vinilo vehicular, vinilo para restaurantes, vinilo para mostradores, vinilos publicitarios Arequipa"
  canonical={`${BASE}servicios/vinilos/`}
>
  <main class="max-w-6xl mx-auto px-4 lg:px-0 py-10 lg:py-16">
    <!-- HERO -->
    <section class="grid lg:grid-cols-2 gap-10 items-center mb-12">
      <div>
        <h1 class="text-3xl lg:text-4xl font-bold mb-4">
          Vinilos personalizados en Arequipa
        </h1>
        <p class="text-lg text-gray-700 mb-4">
          Transformamos vehículos, paredes y mostradores con vinilos impresos y laminados
          de alta calidad. Trabajamos con diseños a medida para que tu negocio se vea
          profesional y llamativo desde cualquier ángulo.
        </p>
        <ul class="space-y-2 text-gray-700 mb-6">
          <li class="flex gap-2">
            <span class="mt-1 h-2 w-2 rounded-full bg-gray-800"></span>
            <span>Vinilo vehicular, murales para restaurantes y vinilos para puntos de venta.</span>
          </li>
          <li class="flex gap-2">
            <span class="mt-1 h-2 w-2 rounded-full bg-gray-800"></span>
            <span>Servicio completo: diseño, impresión e instalación en tu local.</span>
          </li>
          <li class="flex gap-2">
            <span class="mt-1 h-2 w-2 rounded-full bg-gray-800"></span>
            <span>Trabajos realizados en distintos rubros: alimentos, gas, telefonía y más.</span>
          </li>
        </ul>

        <div class="flex flex-wrap gap-3">
          <a
            href={`https://wa.me/${number}?text=Hola,%20quiero%20cotizar%20vinilos%20para%20mi%20negocio%20en%20Arequipa`}
            class="inline-flex items-center justify-center rounded-md bg-green-600 px-5 py-2.5 text-white font-semibold hover:bg-green-700 transition"
          >
            Cotizar por WhatsApp
          </a>
          <a
            href={`${BASE}#trabajos`}
            class="inline-flex items-center justify-center rounded-md border border-gray-300 px-5 py-2.5 text-gray-800 font-semibold hover:bg-gray-100 transition"
          >
            Ver más trabajos
          </a>
        </div>
      </div>

      <!-- Imagen / Mock -->
      <div class="relative">
        <div class="aspect-[4/3] w-full rounded-2xl border border-gray-200 shadow-sm overflow-hidden bg-gray-50 flex items-center justify-center">
          <img
            src={`${base}/vinilo-vehicular-helados.webp`}
            alt="Vinilo vehicular para motocar de helados artesanales"
            loading="lazy"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </section>

    <!-- TIPOS / TRABAJOS EN VINILO -->
    <section class="mb-12">
      <h2 class="text-2xl lg:text-3xl font-bold mb-2">
        Trabajos realizados en vinilo
      </h2>
      <p class="text-gray-700 mb-6">
        Estos son algunos de los proyectos reales que hemos realizado en Arequipa usando vinilos
        impresos y laminados. Cada trabajo se adapta al rubro y al espacio del cliente.
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {vinylTypes.map((item) => (
          <article class="border border-gray-200 rounded-2xl overflow-hidden flex flex-col bg-white">
            <div class="aspect-[4/3] w-full bg-gray-100 overflow-hidden">
              <img
                src={item.image}
                alt={item.title + ' - ' + item.subtitle}
                loading="lazy"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="p-4 flex flex-col flex-1">
              <h3 class="text-lg font-bold mb-1">{item.title}</h3>
              <p class="text-sm text-gray-600 mb-3">
                {item.subtitle}
              </p>
              <ul class="text-sm text-gray-700 space-y-1 mb-4">
                {item.bullets.map((b) => (
                  <li class="flex gap-2">
                    <span class="mt-1 h-1.5 w-1.5 rounded-full bg-gray-800"></span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>

              <a
                href={`https://wa.me/${number}?text=${encodeURIComponent(item.whatsappText)}`}
                class="mt-auto inline-flex items-center justify-center rounded-md bg-green-600 px-3 py-2 text-sm font-semibold text-white hover:bg-green-700 transition"
              >
                Cotizar un trabajo similar
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- BENEFICIOS -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-2">
        ¿Por qué trabajar tus vinilos con Victor Anuncios?
      </h2>
      <p class="text-gray-700 mb-4">
        Nos especializamos en soluciones visuales para negocios en Arequipa. Combinamos buen diseño,
        materiales de calidad e instalación profesional.
      </p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="border border-gray-200 rounded-xl p-4 bg-white">
          <h3 class="font-semibold mb-1">Instalación profesional</h3>
          <p class="text-sm text-gray-700">
            Colocación limpia, sin burbujas y correctamente alineada para que tu marca se vea impecable.
          </p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 bg-white">
          <h3 class="font-semibold mb-1">Materiales duraderos</h3>
          <p class="text-sm text-gray-700">
            Vinilos resistentes al sol y la lluvia, pensados para exteriores e interiores.
          </p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 bg-white">
          <h3 class="font-semibold mb-1">Diseño incluido</h3>
          <p class="text-sm text-gray-700">
            Adaptamos tu logo, textos y promociones al formato correcto de vinilo.
          </p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 bg-white">
          <h3 class="font-semibold mb-1">Asesoría personalizada</h3>
          <p class="text-sm text-gray-700">
            Te ayudamos a decidir el tipo de vinilo y el tamaño ideal según tu superficie y objetivo.
          </p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 bg-white">
          <h3 class="font-semibold mb-1">Trabajo local en Arequipa</h3>
          <p class="text-sm text-gray-700">
            Conocemos el mercado local y respondemos rápido a tus necesidades.
          </p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 bg-white">
          <h3 class="font-semibold mb-1">Buena relación calidad/precio</h3>
          <p class="text-sm text-gray-700">
            Pensado para emprendedores, marcas en crecimiento y negocios consolidados.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="border border-gray-200 rounded-2xl p-6 lg:p-8 bg-gray-50 text-center">
      <h2 class="text-2xl font-bold mb-3">
        ¿Quieres un vinilo así para tu negocio?
      </h2>
      <p class="text-gray-700 mb-5">
        Envíame fotos de tu pared, vehículo o mostrador por WhatsApp y te ayudo a elegir el mejor
        tipo de vinilo para tu caso.
      </p>
      <a
        href={`https://wa.me/${number}?text=Hola,%20quiero%20cotizar%20un%20vinilo%20similar%20a%20los%20de%20tu%20página`}
        class="inline-flex items-center justify-center rounded-md bg-green-600 px-6 py-3 text-white font-semibold hover:bg-green-700 transition"
      >
        Cotizar ahora por WhatsApp
      </a>
    </section>
  </main>
</Layout>
