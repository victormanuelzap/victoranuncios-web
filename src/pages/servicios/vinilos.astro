
---
import Layout from '../../layouts/Layout.astro'

const BASE = import.meta.env.BASE_URL
const base = `${BASE}assets/services/vinilos`
const number = '51946182531'

const vinylTypes = [
  {
    title: 'Vinilo troquelado',
    subtitle: 'Logos y textos recortados',
    image: `${base}/vinilo-troquelado.webp`,
    bullets: [
      'Ideal para logos, textos y formas recortadas',
      'Perfecto para vitrinas, puertas y señalética',
      'Corte preciso y acabado profesional',
    ],
    whatsappText: 'Hola, quiero cotizar vinilo troquelado para mi negocio',
  },
  {
    title: 'Vinilo impreso',
    subtitle: 'Full color en alta resolución',
    image: `${base}/vinilo-impreso.webp`,
    bullets: [
      'Impresión en alta resolución a full color',
      'Para fotos, promociones y publicidad en vitrinas',
      'Recomendado para campañas y anuncios impactantes',
    ],
    whatsappText: 'Hola, quiero cotizar vinilo impreso a full color',
  },
  {
    title: 'Vinilo microperforado',
    subtitle: 'One way vision para vitrinas',
    image: `${base}/vinilo-microperforado.webp`,
    bullets: [
      'Permite ver desde dentro hacia afuera',
      'Ideal para vitrinas de tiendas, oficinas y vehículos',
      'Reduce el impacto del sol manteniendo visibilidad',
    ],
    whatsappText: 'Hola, quiero cotizar vinilo microperforado para vitrinas',
  },
  {
    title: 'Vinilo esmerilado',
    subtitle: 'Privacidad y elegancia',
    image: `${base}/vinilo-esmerilado.webp`,
    bullets: [
      'Aspecto de vidrio arenado/esmerilado',
      'Perfecto para oficinas, consultorios y divisiones de vidrio',
      'Brinda privacidad sin perder iluminación',
    ],
    whatsappText: 'Hola, quiero cotizar vinilo esmerilado para vidrio',
  },
  {
    title: 'Vinilo para vehículos',
    subtitle: 'Rotulación vehicular',
    image: `${base}/vinilo-vehicular.webp`,
    bullets: [
      'Aplicación en autos, camionetas y motos',
      'Ideal para colocar logos y datos de tu marca',
      'Mayor exposición de tu negocio en movimiento',
    ],
    whatsappText: 'Hola, quiero cotizar vinilo para rotular mi vehículo',
  },
]
---

<Layout
  title="Vinilos personalizados en Arequipa | Victor Anuncios"
  description="Diseño, impresión y colocación de vinilos publicitarios en Arequipa: troquelados, impresos, microperforados, esmerilados y vinilos para vehículos. Servicio profesional para vitrinas, negocios y autos."
  keywords="vinilos Arequipa, vinilos publicitarios, vinilos para vitrinas, vinilo microperforado Arequipa, vinilo esmerilado Arequipa, rotulación vehicular Arequipa"
  canonical={`${BASE}servicios/vinilos/`}
>
  <main class="max-w-6xl mx-auto px-4 lg:px-0 py-10 lg:py-16">
    <!-- HERO -->
    <section class="grid lg:grid-cols-2 gap-10 items-center mb-12">
      <div>
        <h1 class="text-3xl lg:text-4xl font-bold mb-4">
          Vinilos personalizados en Arequipa
        </h1>
        <p class="text-lg text-gray-700 mb-4">
          Diseño, impresión y colocación profesional de vinilos para vitrinas, negocios, oficinas y vehículos.
          Trabajamos con materiales de alta duración y acabados limpios para que tu marca se vea nítida y profesional.
        </p>
        <ul class="space-y-2 text-gray-700 mb-6">
          <li class="flex gap-2">
            <span class="mt-1 h-2 w-2 rounded-full bg-gray-800"></span>
            <span>Vinilos troquelados, impresos, microperforados, esmerilados y vehiculares.</span>
          </li>
          <li class="flex gap-2">
            <span class="mt-1 h-2 w-2 rounded-full bg-gray-800"></span>
            <span>Servicio completo: diseño, impresión y colocación en tu local.</span>
          </li>
          <li class="flex gap-2">
            <span class="mt-1 h-2 w-2 rounded-full bg-gray-800"></span>
            <span>Atención en toda Arequipa.</span>
          </li>
        </ul>

        <div class="flex flex-wrap gap-3">
          <a
            href={`https://wa.me/${number}?text=Hola,%20quiero%20cotizar%20vinilos%20para%20mi%20negocio%20en%20Arequipa`}
            class="inline-flex items-center justify-center rounded-md bg-green-600 px-5 py-2.5 text-white font-semibold hover:bg-green-700 transition"
          >
            Cotizar por WhatsApp
          </a>
          <a
            href={`${BASE}#trabajos`}
            class="inline-flex items-center justify-center rounded-md border border-gray-300 px-5 py-2.5 text-gray-800 font-semibold hover:bg-gray-100 transition"
          >
            Ver trabajos realizados
          </a>
        </div>
      </div>

      <!-- Imagen / Mock -->
      <div class="relative">
        <div class="aspect-[4/3] w-full rounded-2xl border border-gray-200 shadow-sm overflow-hidden bg-gray-50 flex items-center justify-center">
          <p class="text-center text-gray-500 px-6">
            Aquí puedes mostrar una foto de vinilos instalados en vitrinas o vehículos de
            <span class="font-semibold">Victor Anuncios</span>.
            Solo reemplaza esta caja por tu imagen real.
          </p>
        </div>
      </div>
    </section>

    <!-- TIPOS DE VINILO -->
    <section class="mb-12">
      <h2 class="text-2xl lg:text-3xl font-bold mb-2">
        Tipos de vinilo que trabajamos
      </h2>
      <p class="text-gray-700 mb-6">
        Escoge el tipo de vinilo que mejor se adapta a tu proyecto. Te asesoramos para elegir el material adecuado según la superficie, el tiempo de uso y el efecto visual que quieras lograr.
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {vinylTypes.map((item) => (
          <article class="border border-gray-200 rounded-2xl overflow-hidden flex flex-col bg-white">
            <div class="aspect-[4/3] w-full bg-gray-100 overflow-hidden">
              <img
                src={item.image}
                alt={item.title}
                loading="lazy"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="p-4 flex flex-col flex-1">
              <h3 class="text-lg font-bold mb-1">{item.title}</h3>
              <p class="text-sm text-gray-600 mb-3">
                {item.subtitle}
              </p>
              <ul class="text-sm text-gray-700 space-y-1 mb-4">
                {item.bullets.map((b) => (
                  <li class="flex gap-2">
                    <span class="mt-1 h-1.5 w-1.5 rounded-full bg-gray-800"></span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>

              <a
                href={`https://wa.me/${number}?text=${encodeURIComponent(item.whatsappText)}`}
                class="mt-auto inline-flex items-center justify-center rounded-md bg-green-600 px-3 py-2 text-sm font-semibold text-white hover:bg-green-700 transition"
              >
                Cotizar este tipo de vinilo
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- BENEFICIOS -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-2">
        Beneficios de trabajar vinilos con Victor Anuncios
      </h2>
      <p class="text-gray-700 mb-4">
        Nos especializamos en soluciones visuales para negocios en Arequipa. Cuidamos tanto el diseño como el acabado final en la instalación.
      </p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="border border-gray-200 rounded-xl p-4 bg-white">
          <h3 class="font-semibold mb-1">Instalación profesional</h3>
          <p class="text-sm text-gray-700">
            Colocación limpia, sin burbujas y con buen alineado para que tu negocio se vea impecable.
          </p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 bg-white">
          <h3 class="font-semibold mb-1">Materiales duraderos</h3>
          <p class="text-sm text-gray-700">
            Vinilos resistentes al sol y la lluvia, ideales para exteriores e interiores.
          </p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 bg-white">
          <h3 class="font-semibold mb-1">Diseño incluido</h3>
          <p class="text-sm text-gray-700">
            Te ayudamos con el diseño y la adaptación de tu logo, textos y promociones.
          </p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 bg-white">
          <h3 class="font-semibold mb-1">Asesoría personalizada</h3>
          <p class="text-sm text-gray-700">
            Te recomendamos el tipo de vinilo correcto según tu superficie y objetivo.
          </p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 bg-white">
          <h3 class="font-semibold mb-1">Trabajo local en Arequipa</h3>
          <p class="text-sm text-gray-700">
            Conocemos las necesidades de los negocios locales y ofrecemos respuesta rápida.
          </p>
        </div>
        <div class="border border-gray-200 rounded-xl p-4 bg-white">
          <h3 class="font-semibold mb-1">Precios competitivos</h3>
          <p class="text-sm text-gray-700">
            Excelente relación calidad/precio para emprendedores y negocios en crecimiento.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4">
        Preguntas frecuentes sobre vinilos
      </h2>
      <div class="space-y-4">
        <details class="border border-gray-200 rounded-xl p-4 bg-white">
          <summary class="font-semibold cursor-pointer">
            ¿Qué duración tienen los vinilos?
          </summary>
          <p class="mt-2 text-sm text-gray-700">
            Dependiendo del tipo de vinilo y la exposición al sol, pueden durar entre 2 y 5 años. Para interiores su vida útil suele ser mayor.
          </p>
        </details>
        <details class="border border-gray-200 rounded-xl p-4 bg-white">
          <summary class="font-semibold cursor-pointer">
            ¿Hacen instalación a domicilio?
          </summary>
          <p class="mt-2 text-sm text-gray-700">
            Sí, realizamos instalación en toda Arequipa. El costo de instalación varía según la zona, tamaño y altura del trabajo.
          </p>
        </details>
        <details class="border border-gray-200 rounded-xl p-4 bg-white">
          <summary class="font-semibold cursor-pointer">
            ¿Pueden diseñar el arte del vinilo?
          </summary>
          <p class="mt-2 text-sm text-gray-700">
            Sí, el servicio de diseño está incluido. Podemos trabajar con tu logo y propuesta o crear una opción desde cero para tu negocio.
          </p>
        </details>
        <details class="border border-gray-200 rounded-xl p-4 bg-white">
          <summary class="font-semibold cursor-pointer">
            ¿Qué necesito para pedir una cotización?
          </summary>
          <p class="mt-2 text-sm text-gray-700">
            Envíanos fotos de la superficie, medidas aproximadas y una idea de lo que quieres (logo, texto, promoción). Con eso te damos un precio estimado.
          </p>
        </details>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="border border-gray-200 rounded-2xl p-6 lg:p-8 bg-gray-50 text-center">
      <h2 class="text-2xl font-bold mb-3">
        ¿Listo para renovar tus vitrinas con vinilos?
      </h2>
      <p class="text-gray-700 mb-5">
        Escríbeme por WhatsApp y coordinamos el diseño, la impresión y la instalación de tus vinilos
        en Arequipa.
      </p>
      <a
        href={`https://wa.me/${number}?text=Hola,%20quiero%20cotizar%20vinilos%20para%20mi%20negocio`}
        class="inline-flex items-center justify-center rounded-md bg-green-600 px-6 py-3 text-white font-semibold hover:bg-green-700 transition"
      >
        Cotizar ahora por WhatsApp
      </a>
    </section>
  </main>
</Layout>
