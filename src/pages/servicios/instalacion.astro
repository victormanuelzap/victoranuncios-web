---
import Layout from '../../layouts/Layout.astro'

// BASE para que funcione en local y en GitHub Pages
const BASE = import.meta.env.BASE_URL
const base = `${BASE}assets/images/instalacion`

// Lista de imágenes (las que tienes en la carpeta)
const images = [
  'instalacion-1.jpg',
  'instalacion-2.jpg',
  'instalacion-3.jpg',
  'instalacion-4.jpg',
  'instalacion-5.jpg',
  'instalacion-6.jpg',
  'instalacion-7.jpg',
]

// Tarjetas
const cards = images.map((img, index) => ({
  title: `Instalación ${index + 1} - Victor Anuncios Arequipa`,
  img: `${base}/${img}`,
}))
---

<Layout title="Instalaciones - Victor Anuncios">
  <section class="mt-10">
    <h2 class="text-3xl font-bold text-center mb-6">
      Instalaciones realizadas
    </h2>

    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {cards.map((card) => (
          <article class="bg-slate-100 rounded-3xl p-4 shadow-sm flex flex-col">
            <div class="aspect-[4/3] w-full overflow-hidden rounded-2xl mb-3">
              <img
                src={card.img}
                alt={card.title}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>

            <p class="text-sm md:text-base font-medium">
              {card.title}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
