---
import Layout from '../../layouts/Layout.astro'

// BASE correcta para GitHub Pages
const BASE = import.meta.env.BASE_URL
const base = `${BASE}assets/services/letrero-luminoso`

// Lista de imágenes del catálogo
const images = [
  'img-1.png',
  'img-2.png',
  'img-3.png',
  'img-4.png',
  'img-5.png',
  'img-6.png',
  'img-7.png',
  'img-8.png',
  'img-9.png',
  'img-10.png',
]

// Tarjetas del catálogo
const cards = images.map((img, index) => ({
  title: `Caja de luz / letrero luminoso modelo ${index + 1} - Victor Anuncios Arequipa`,
  img: `${base}/${img}`,
}))
---
<section class="mt-10">
  <h2 class="text-3xl font-bold text-center mb-6">Catálogo</h2>

  <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-6">
    {cards.map((card) => (
      <article class="bg-slate-100 rounded-3xl p-4 shadow-sm flex flex-col">
        <img
          src={card.img}
          alt={card.title}
          class="w-full h-52 object-cover rounded-2xl mb-3"
          loading="lazy"
        />
        <p class="text-sm md:text-base font-medium">
          {card.title}
        </p>
      </article>
    ))}
  </div>
</section>
