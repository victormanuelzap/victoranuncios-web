---
import Layout from "../layouts/Layout.astro"

const BASE = import.meta.env.BASE_URL
const image = `${BASE}assets/rollscreen/roll.png`  // cambia el nombre del archivo
---

<Layout
  title="Roll Screen en Arequipa | Victor Anuncios"
  description="Roll Screen publicitario para eventos, ferias y presentaciones. Fácil de transportar y listo para usar."
  canonical="/rollscreen/"
>
  <main class="bg-red-600 text-white">

    <!-- HERO TIPO PRODUCTO ROLL SCREEN -->
    <section class="min-h-screen flex items-center">
      <div class="mx-auto max-w-7xl px-6 grid lg:grid-cols-2 gap-10 items-center">

        <!-- IMAGEN DEL ROLL SCREEN -->
        <div class="flex justify-center">
          <img
            src={image}
            alt="Roll Screen Publicitario"
            class="w-full max-w-md object-contain drop-shadow-xl"
          />
        </div>

        <!-- TEXTO -->
        <div class="space-y-6">
          <h1 class="text-5xl font-extrabold">Roll Screen</h1>

          <div class="space-y-3 text-white/90 text-lg">
            <p><strong>Versátil:</strong> Herramienta publicitaria plegable para interiores y eventos.</p>
            <p><strong>Fácil de trasladar:</strong> Incluye bolso para transporte.</p>
            <p><strong>Ideal para negocios:</strong> Presenta tus promociones de manera profesional.</p>
          </div>

          <a
            href="https://wa.me/51946182531?text=Hola,%20quiero%20un%20Roll%20Screen."
            class="inline-block bg-black px-6 py-3 text-sm font-semibold rounded-md border border-white hover:bg-white hover:text-black transition"
          >
            COMPRAR
          </a>
        </div>

      </div>
    </section>

  </main>
</Layout>
