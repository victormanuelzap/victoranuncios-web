---
import Layout from '../../layouts/Layout.astro'

const BASE = import.meta.env.BASE_URL
const base = `${BASE}assets/services/3d`

// CATÁLOGO: todas las imágenes antiguas + las nuevas
const images = [
  'img-1.png','img-2.png','img-3.png','img-4.png','img-5.png',
  'img-6.png','img-7.png','img-8.png','img-10.png',
  'img-11.png','img-12.png','img-13.png','img-14.png','img-15.png',

  // proyectos nuevos
  'identa.png',
  'autodoc.png',
  'senorial.png',
  'soluciones.png',
  'bull12.png',
  'polleria-torre.png', // sigue en catálogo
  'panesur.png',        // nuevo proyecto
]

// PROYECTOS DESTACADOS (incluye PANESUR en lugar de pollería)
const featured = [
  {
    src: `${base}/identa.png`,
    alt: 'Letrero 3D Identa odontología en Arequipa',
    title: 'LETRERO 3D PROYECTO – IDENTÁ',
    bullets: [
      'Material: PVC / Acrílico / Metal',
      'Acabado: pintura automotriz y vinil de alta durabilidad',
      'Iluminación: sin iluminación (relieve 3D)',
      'Uso: interiores y fachadas',
      'Detalle: logotipo dental en volumen y lettering en doble capa',
      'Garantía: 1 año',
    ],
    wa: encodeURIComponent('Quiero cotizar un letrero 3D similar al proyecto IDENTÁ'),
  },
  {
    src: `${base}/autodoc.png`,
    alt: 'Letrero 3D Autodoc Service taller automotriz',
    title: 'LETRERO 3D PROYECTO – AUTODOC SERVICE',
    bullets: [
      'Material: PVC / Acrílico de alto espesor',
      'Acabado: pintura automotriz profesional',
      'Iluminación: sin iluminación (relieve 3D)',
      'Uso: interiores y exteriores',
      'Detalle: íconos mecánicos en volumen y tipografía combinada',
      'Garantía: 1 año',
    ],
    wa: encodeURIComponent('Quiero cotizar un letrero 3D similar al proyecto AUTODOC SERVICE'),
  },
  {
    src: `${base}/senorial.png`,
    alt: 'Letrero luminoso Señoríal con letras 3D',
    title: 'LETRERO LUMINOSO PROYECTO – SEÑORÍAL',
    bullets: [
      'Material: estructura metálica / acrílico / PVC',
      'Acabado: pintura automotriz + vinil',
      'Iluminación: LED frontal de alta intensidad',
      'Uso: fachadas comerciales y exteriores',
      'Detalle: caja de luz con letras 3D iluminadas y slogan inferior',
      'Garantía: 1 año',
    ],
    wa: encodeURIComponent('Quiero cotizar un letrero luminoso similar al proyecto SEÑORÍAL'),
  },
  {
    src: `${base}/soluciones.png`,
    alt: 'Letrero luminoso Soluciones Médicas Policlínico',
    title: 'LETRERO LUMINOSO PROYECTO – SOLUCIONES MÉDICAS',
    bullets: [
      'Material: estructura metálica / acrílico / PVC',
      'Acabado: pintura automotriz y vinil de alta calidad',
      'Iluminación: LED frontal para máxima visibilidad',
      'Uso: fachadas de clínicas y policlínicos',
      'Detalle: letras 3D rojas y negras en relieve con diseño moderno',
      'Garantía: 1 año',
    ],
    wa: encodeURIComponent('Quiero cotizar un letrero luminoso similar al proyecto SOLUCIONES MÉDICAS'),
  },
  {
    src: `${base}/bull12.png`,
    alt: 'Fachada luminosa Bull 12 Rock & Grill',
    title: 'LETRERO LUMINOSO PROYECTO – BULL 12 ROCK & GRILL',
    bullets: [
      'Material: estructura metálica / acrílico / PVC',
      'Acabado: pintura automotriz en tonos personalizados y vinil',
      'Iluminación: LED interno para iluminación nocturna del logotipo',
      'Uso: fachadas comerciales y exteriores',
      'Detalle: caja luminosa central con logotipo 3D y número telefónico',
      'Garantía: 1 año',
    ],
    wa: encodeURIComponent('Quiero cotizar un letrero luminoso similar al proyecto BULL 12'),
  },
  {
    src: `${base}/panesur.png`,
    alt: 'Letras 3D Panesur sobre muro de listones de madera',
    title: 'LETRERO 3D PROYECTO – PANESUR',
    bullets: [
      'Material: letras corpóreas en PVC 3D',
      'Acabado: pintura automotriz blanca con detalles en vinil naranja',
      'Iluminación: apoyo con luz decorativa RGB (no integrada en las letras)',
      'Uso: interiores, fondos de recepción y muros de marca',
      'Detalle: letras 3D instaladas sobre panel de listones de madera',
      'Garantía: 1 año',
    ],
    wa: encodeURIComponent('Quiero cotizar un letrero 3D similar al proyecto PANESUR'),
  },
]
---

<Layout
  title="Letreros 3D en Arequipa | Victor Anuncios"
  description="Fabricamos e instalamos letreros 3D: acrílico, PVC y metálicos. Diseño, corte preciso e instalación con garantía en Arequipa."
  keywords="letreros 3D Arequipa, letras corpóreas, acrílico 3D, PVC 3D, letras metálicas"
  canonical="https://victoranuncios.com/servicios/3d"
>
  <!-- HERO -->
  <section class="relative">
    <img
      src={`${base}/hero-nuevo.png`}
      alt="Letreros 3D Victor Anuncios"
      class="h-80 md:h-[420px] w-full object-cover"
      loading="eager"
    />
    <div class="absolute top-0 left-0 w-full h-full bg-black bg-opacity-50 flex justify-center items-center">
      <h1 class="text-white text-4xl md:text-6xl font-bold uppercase text-center">
        LETREROS 3D
      </h1>
    </div>
  </section>

  <main class="container mx-auto px-4 pt-10 pb-16">
    <div class="flex flex-wrap items-center justify-center gap-3 mb-10">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gray-100 text-gray-700 text-sm">✅ Corte preciso</span>
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gray-100 text-gray-700 text-sm">✍️ Diseño + instalación</span>
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gray-100 text-gray-700 text-sm">🛡️ Garantía 1 año</span>
    </div>

    <!-- CATÁLOGO -->
    <section aria-labelledby="catalogo3d" class="mt-2">
      <h2 id="catalogo3d" class="text-2xl md:text-3xl font-bold text-center mb-8">
        Catálogo
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 md:gap-4">
        {images.map((file, i) => (
          <figure class="relative aspect-square overflow-hidden rounded-xl bg-gray-100">
            <img
              src={`${base}/${file}`}
              alt={`Letrero 3D modelo ${i + 1} - Victor Anuncios Arequipa`}
              loading={i < 4 ? 'eager' : 'lazy'}
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-200 hover:scale-105"
            />
          </figure>
        ))}
      </div>
    </section>

    <!-- PROYECTOS DESTACADOS -->
    <section aria-labelledby="proyectos3d" class="mt-14">
      <h2 id="proyectos3d" class="text-2xl md:text-3xl font-bold text-center mb-8">
        Proyectos destacados
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {featured.map((t) => (
          <article class="text-center bg-white rounded-2xl shadow-md p-4 md:p-6">
            <div class="relative w-full h-56 mb-4">
              <img
                src={t.src}
                alt={t.alt}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover rounded-xl shadow-sm"
              />
            </div>

            <h3 class="text-xl font-extrabold text-black mb-2">
              {t.title}
            </h3>

            <ul class="text-left text-gray-700 space-y-1 mb-5">
              {t.bullets.map((b) => <li>• {b}</li>)}
            </ul>

            {/* BOTÓN AZUL POR PROYECTO */}
            <a
              href={`https://wa.me/51946182531?text=${t.wa}`}
              target="_blank"
              rel="noopener"
              class="inline-block bg-blue-600 hover:bg-blue-500 text-white font-bold px-6 py-2 rounded-lg transition"
            >
              Cotizar por WhatsApp
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="mt-12">
      <div class="rounded-2xl bg-blue-600 text-white p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-4 md:gap-6">
        <p class="text-lg md:text-xl font-semibold text-center md:text-left">
          ¿Quieres un letrero 3D como estos? Diseño + fabricación + instalación.
        </p>
        {/* BOTÓN CTA BLANCO PARA CONTRASTE */}
        <a
          href="https://wa.me/51946182531?text=Quiero%20un%20letrero%203D"
          class="px-5 py-3 bg-white text-blue-700 rounded-lg font-bold whitespace-nowrap hover:bg-gray-100 transition"
          rel="noopener"
        >
          Pedir por WhatsApp
        </a>
      </div>
    </section>
  </main>
</Layout>
