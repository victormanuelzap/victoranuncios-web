{/* LIGHTBOX / MODAL */}
<div id="img-modal" class="fixed inset-0 z-[999] hidden">
  <div id="img-modal-backdrop" class="absolute inset-0 bg-black/75"></div>

  <div class="relative w-full h-full flex items-center justify-center p-4">
    <div class="relative max-w-5xl w-full">
      {/* Botones esquina superior derecha */}
      <div class="absolute -top-3 right-0 flex items-center gap-2">
        <a
          id="img-modal-link"
          href="#"
          class="icon-btn"
          aria-label="Ver mejor"
        >
          Ver mejor
        </a>

        <button
          id="img-modal-close"
          type="button"
          class="icon-btn"
          aria-label="Cerrar"
        >
          ×
        </button>
      </div>

      <img
        id="img-modal-img"
        src=""
        alt="Vista ampliada"
        class="w-full max-h-[82vh] object-contain rounded-2xl bg-black/20"
      />
    </div>
  </div>
</div>



  <!-- Animaciones: reveal al hacer scroll -->
  <script is:inline>
    (function () {
      const els = document.querySelectorAll('.reveal');
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) e.target.classList.add('is-visible');
          });
        },
        { threshold: 0.12 }
      );
      els.forEach((el) => io.observe(el));
    })();
  </script>


 <!-- Script completo: slider (tiempo editable) + modal click + cerrar aqui se  CONTROLA  -->
    <script is:inline>
  (function () {
    // =========================
    // CONFIGURACIÓN
    // =========================
    const SLIDER_INTERVAL_MS = 2000; // <-- Cambia aquí: 1500 (1.5s) o 2000 (2s)

    // =========================
    // MINI SLIDER (solo imágenes con data-slider="true")
    // =========================
    const sliderImgs = document.querySelectorAll('img[data-slider="true"]');

    sliderImgs.forEach((img) => {
      let slides = [];
      try {
        slides = JSON.parse(img.getAttribute('data-slides') || '[]');
      } catch (e) {
        slides = [];
      }
      if (!slides.length) return;

      let i = 0;

      // Preload (para que no parpadee)
      slides.forEach((src) => {
        const pre = new Image();
        pre.src = src;
      });

      setInterval(() => {
        i = (i + 1) % slides.length;
        img.classList.add('fade-out');

        setTimeout(() => {
          img.src = slides[i];
          img.classList.remove('fade-out');
        }, 180);
      }, SLIDER_INTERVAL_MS);
    });

    // =========================
    // MODAL (lightbox)
    // =========================
    const modal = document.getElementById('img-modal');
    const modalImg = document.getElementById('img-modal-img');
    const modalClose = document.getElementById('img-modal-close');
    const modalBackdrop = document.getElementById('img-modal-backdrop');
    const modalLink = document.getElementById('img-modal-link');

    function openModal(src, href) {
      if (!modal || !modalImg || !modalLink) return;
      modalImg.src = src;
      modalLink.href = href || '#';
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal || !modalImg) return;
      modal.classList.add('hidden');
      modalImg.src = '';
      document.body.style.overflow = '';
    }

    // Click en cualquier imagen de los cards (incluye slider y normales)
    document.querySelectorAll('.modelo-media').forEach((img) => {
      img.addEventListener('click', () => {
        const src = img.getAttribute('src');
        const href = img.getAttribute('data-preview');
        if (src) openModal(src, href);
      });
    });

    // Cerrar: botón, backdrop, tecla ESC
    if (modalClose) modalClose.addEventListener('click', closeModal);
    if (modalBackdrop) modalBackdrop.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  })();
</script>



  <style is:global>
    .reveal {
      opacity: 0;
      transform: translateY(14px);
      transition: opacity 700ms ease, transform 700ms ease;
      will-change: opacity, transform;
    }
    .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Fade suave del mini slider */
img[data-slider="true"] {
  transition: opacity 180ms ease;
}
img[data-slider="true"].fade-out {
  opacity: 0.2;
}

/* Botones del modal: transparente, borde redondeado, solo se ve el “cuadro” y el texto/X */
.icon-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 44px;
  padding: 0 14px;
  border-radius: 9999px;
  border: 1px solid rgba(255,255,255,0.35);
  background: rgba(0,0,0,0.25);
  color: white;
  font-weight: 700;
  backdrop-filter: blur(8px);
  text-decoration: none;
}
.icon-btn:hover {
  background: rgba(0,0,0,0.4);
  border-color: rgba(255,255,255,0.55);
}

/* Botón X más “icono” */
#img-modal-close {
  width: 44px;
  padding: 0;
  font-size: 26px;
  line-height: 1;
}


    @media (prefers-reduced-motion: reduce) {
      .reveal,
      .reveal.is-visible {
        transition: none !important;
        transform: none !important;
        opacity: 1 !important;

      }
    }
  </style>
</Layout>
