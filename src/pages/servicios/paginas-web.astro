---
import Layout from '../../../layouts/Layout.astro'

const pageTitle = 'Páginas web en Arequipa | Victor Anuncios'
const pageDescription =
  'Diseño y desarrollo de páginas web rápidas, optimizadas para Google, con WhatsApp y diseño profesional en Arequipa.'
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="max-w-5xl mx-auto px-4 py-10">
    <header class="mb-8">
      <h1 class="text-3xl md:text-4xl font-extrabold text-neutral-900">Páginas web</h1>
      <p class="mt-3 text-neutral-600">
        Creamos páginas web modernas para negocios en Arequipa: rápidas, seguras y listas para posicionar en Google,
        con botón de WhatsApp y diseño profesional.
      </p>
    </header>

    <section class="grid md:grid-cols-3 gap-4">
      <div class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm">
        <h2 class="font-semibold text-neutral-900">Web corporativa</h2>
        <p class="mt-2 text-sm text-neutral-600">Ideal para mostrar tu empresa, servicios, fotos y contacto.</p>
      </div>

      <div class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm">
        <h2 class="font-semibold text-neutral-900">Landing Page</h2>
        <p class="mt-2 text-sm text-neutral-600">Una sola página enfocada en ventas y WhatsApp.</p>
      </div>

      <div class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm">
        <h2 class="font-semibold text-neutral-900">SEO básico + WhatsApp</h2>
        <p class="mt-2 text-sm text-neutral-600">Estructura y contenido para que Google te encuentre.</p>
      </div>
    </section>

    <section class="mt-10 rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-bold text-neutral-900">Pide tu cotización</h2>
      <p class="mt-2 text-neutral-600">
        Escríbenos y te enviamos una propuesta con tiempos, secciones y precio.
      </p>

      <a
        class="inline-flex mt-4 items-center justify-center rounded-xl bg-blue-700 px-5 py-3 text-white font-semibold hover:bg-blue-800 transition"
        href="https://wa.me/51946182531?text=Hola%20Victor%2C%20quiero%20una%20p%C3%A1gina%20web%20para%20mi%20negocio."
        target="_blank"
        rel="noopener"
      >
        Hablar por WhatsApp
      </a>
    </section>
  </main>
</Layout>
