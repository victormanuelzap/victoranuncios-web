---
import Layout from '../../layouts/Layout.astro'

// Base correcta para local / GitHub Pages
const BASE = import.meta.env.BASE_URL

// Carpeta sugerida para assets (tú la creas):
// public/assets/services/paginas-web/
const base =
  BASE === '/'
    ? '/assets/services/paginas-web'
    : '/victoranuncios-web/assets/services/paginas-web'

// Modelos / demos (reemplaza imágenes cuando tengas)
const modelos = [
  {
    titulo: 'Landing Page (1 página)',
    desc: 'Ideal para promocionar un servicio y captar clientes por WhatsApp.',
    img: `${base}/modelo-1.webp`,
    tags: ['Rápida', 'Enfocada en ventas', 'WhatsApp'],
    waText: 'Hola%20Victor,%20quiero%20una%20Landing%20Page%20para%20mi%20negocio',
    previewHref: `${BASE === '/' ? '/disenos/' : '/victoranuncios-web/disenos/'}`,
  },
  {
    titulo: 'Web Corporativa (3–6 secciones)',
    desc: 'Tu negocio con presencia profesional, servicios, galería y contacto.',
    slides: [
      `${base}/modelb1.webp`,
      `${base}/modelb2.webp`,
      `${base}/modelb3.webp`,
      `${base}/modelb4.webp`,
      `${base}/modelb5.webp`,
      `${base}/modelb6.webp`,
    ],
    tags: ['Profesional', 'Google', 'Servicios'],
    waText: 'Hola%20Victor,%20quiero%20una%20web%20corporativa%20para%20mi%20negocio',
    previewHref: `${BASE === '/' ? '/disenos/' : '/victoranuncios-web/disenos/'}`,
  },
  {
    titulo: 'Catálogo / Portafolio',
    desc: 'Perfecto para mostrar trabajos, productos, precios y testimonios.',
    img: `${base}/modelo-3.webp`,
    tags: ['Portafolio', 'Catálogo', 'Fácil de actualizar'],
    waText:
      'Hola%20Victor,%20quiero%20una%20web%20tipo%20cat%C3%A1logo%20para%20mi%20negocio',
    previewHref: `${BASE === '/' ? '/disenos/' : '/victoranuncios-web/disenos/'}`,
  },
]

---

<Layout
  title="Páginas web en Arequipa – Diseño moderno y profesional | Victor Anuncios"
  description="Creamos páginas web modernas en Arequipa: landing pages, webs corporativas y catálogos. Diseño premium, velocidad y enfoque en ventas."
  keywords="paginas web Arequipa, diseño web Arequipa, desarrollo web Arequipa, landing page Arequipa, Victor Anuncios"
  canonical="https://victoranuncios.com/servicios/paginas-web/"
>
  <!-- HERO FULL SCREEN (premium) -->
  <section class="relative min-h-[92vh] overflow-hidden bg-[#050B18] text-white">
    <!-- Fondo: gradientes + blobs -->
    <div class="absolute inset-0">
