            </a>
          </div>

          <div class="mt-8 flex flex-wrap gap-3 text-sm text-white/80">
            <span class="px-3 py-2 rounded-xl bg-white/5 border border-white/10">📍 Arequipa (y todo Perú)</span>
            <span class="px-3 py-2 rounded-xl bg-white/5 border border-white/10">🔎 SEO básico incluido</span>
            <span class="px-3 py-2 rounded-xl bg-white/5 border border-white/10">🛠️ Soporte y mantenimiento</span>
          </div>
        </div>

        <!-- “Mockup” (sin imagen obligatoria) -->
        <div class="reveal">
          <div class="relative rounded-3xl border border-white/10 bg-white/5 shadow-2xl overflow-hidden">
            <div class="p-4 border-b border-white/10 flex items-center gap-2">
              <span class="h-3 w-3 rounded-full bg-white/30"></span>
              <span class="h-3 w-3 rounded-full bg-white/20"></span>
              <span class="h-3 w-3 rounded-full bg-white/10"></span>
              <span class="ml-3 text-xs text-white/70">www.victoranuncios.com</span>
            </div>

            <div class="p-6 md:p-7">
              <div class="rounded-2xl bg-gradient-to-br from-white/10 to-white/5 border border-white/10 p-6">
                <p class="text-xs text-white/60">Sección destacada</p>
                <h3 class="mt-2 text-2xl md:text-3xl font-extrabold">
                  Web premium con animaciones suaves
                </h3>
                <p class="mt-3 text-white/75 text-sm md:text-base leading-relaxed">
                  Efectos de entrada, scroll reveal, botones con transiciones y diseño limpio.
                  Sin exagerar, pero se siente “caro”.
                </p>

                <div class="mt-5 grid grid-cols-3 gap-3">
                  <div class="h-20 rounded-xl bg-white/5 border border-white/10"></div>
                  <div class="h-20 rounded-xl bg-white/5 border border-white/10"></div>
                  <div class="h-20 rounded-xl bg-white/5 border border-white/10"></div>
                </div>
              </div>

              <div class="mt-5 grid grid-cols-2 gap-3">
                <div class="h-12 rounded-xl bg-white/5 border border-white/10"></div>
                <div class="h-12 rounded-xl bg-white/5 border border-white/10"></div>
              </div>
            </div>

            <div class="absolute -bottom-24 -right-24 h-72 w-72 rounded-full bg-cyan-400/25 blur-3xl"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Degradado a blanco (como tus otros servicios) -->
    <div class="absolute bottom-0 left-0 w-full h-24 bg-gradient-to-b from-transparent to-white"></div>
  </section>

  <main class="bg-white">
    <!-- Sección: Modelos -->
    <section id="modelos" class="max-w-[1250px] mx-auto px-6 pt-14 pb-8">
      <div class="reveal">
        <h2 class="text-3xl md:text-4xl font-extrabold text-neutral-900 text-center">
          Modelos de página
        </h2>
        <p class="mt-3 text-center text-neutral-600 max-w-2xl mx-auto">
          Elige el estilo que mejor encaje con tu negocio. Luego lo personalizamos con tus colores, fotos y contenido.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-6">
        {modelos.map((m) => (
          <article class="reveal rounded-3xl bg-white border border-gray-200 shadow-sm overflow-hidden hover:shadow-lg transition">
            <div class="relative h-52 bg-gray-100 overflow-hidden">
  {/* Si tiene slides => mini slider. Si no => imagen normal */}
  {m.slides ? (
    <img
      src={m.slides[0]}
      alt={`Modelo de página web: ${m.titulo}`}
      class="modelo-media absolute inset-0 w-full h-full object-cover cursor-zoom-in"
      loading="lazy"
      decoding="async"
      data-slider="true"
      data-slides={JSON.stringify(m.slides)}
      data-preview={m.previewHref}
    />
  ) : (
    <img
      src={m.img}
      alt={`Modelo de página web: ${m.titulo}`}
      class="modelo-media absolute inset-0 w-full h-full object-cover cursor-zoom-in"
      loading="lazy"
      decoding="async"
      data-preview={m.previewHref}
      onerror="this.style.display='none'"
    />
  )}

  <div class="absolute inset-0 bg-gradient-to-t from-black/35 to-transparent pointer-events-none"></div>

  {/* Indicador “Auto” solo para el slider (opcional) */}
  {m.slides && (
    <div class="absolute bottom-3 left-3 text-[11px] px-2 py-1 rounded-full bg-black/50 text-white border border-white/15">
      Auto
    </div>
  )}
</div>


            <div class="p-5">
              <h3 class="text-xl font-extrabold text-neutral-900">{m.titulo}</h3>
              <p class="mt-2 text-neutral-600 leading-relaxed">{m.desc}</p>

              <div class="mt-4 flex flex-wrap gap-2">
                {m.tags.map((t) => (
                  <span class="text-xs font-semibold px-3 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-100">
                    {t}
                  </span>
                ))}
              </div>

              <a
                href={`https://wa.me/51946182531?text=${m.waText}`}
                target="_blank"
                rel="noopener"
                class="mt-5 inline-flex w-full justify-center items-center gap-2 bg-blue-600 hover:bg-blue-500 text-white font-bold px-5 py-3 rounded-xl transition"
              >
                Pedir por WhatsApp
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Sección: Proceso (premium) -->
    <section class="max-w-[1250px] mx-auto px-6 pt-8 pb-16">
      <div class="reveal rounded-3xl border border-gray-200 bg-gradient-to-br from-white to-blue-50 p-6 md:p-10">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div>
            <h2 class="text-2xl md:text-3xl font-extrabold text-neutral-900">
              Proceso de trabajo (claro y rápido)
            </h2>
            <p class="mt-2 text-neutral-600 max-w-2xl">
              Para que avances sin estrés: tú envías información y nosotros hacemos el diseño, estructura y publicación.
            </p>
          </div>

          <a
            href="https://wa.me/51946182531?text=Hola%20Victor,%20quiero%20saber%20el%20proceso%20para%20hacer%20mi%20p%C3%A1gina%20web"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center bg-white border border-gray-200 px-5 py-3 rounded-xl font-bold text-neutral-900 hover:bg-gray-50 transition"
          >
            Consultar
          </a>
        </div>

        <div class="mt-8 grid grid-cols-1 md:grid-cols-4 gap-4">
          {[
            ['1) Brief', 'Rubro, nombre, servicios, referencias, WhatsApp y redes.'],
            ['2) Diseño', 'Propuesta visual premium + estructura enfocada en conversión.'],
            ['3) Ajustes', 'Afinamos textos, secciones, fotos y llamados a la acción.'],
            ['4) Publicación', 'Dominio, hosting, indexación básica y medición.'],
          ].map(([t, d]) => (
            <div class="reveal rounded-2xl bg-white border border-gray-200 p-5">
              <h3 class="font-extrabold text-neutral-900">{t}</h3>
              <p class="mt-2 text-neutral-600 text-sm leading-relaxed">{d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA final -->
    <section class="max-w-[1250px] mx-auto px-6 pb-16">
      <div class="reveal rounded-3xl bg-[#0B1A2D] text-white p-7 md:p-10 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <h2 class="text-2xl md:text-3xl font-extrabold">
            ¿Listo para una web que se vea “pro”?
          </h2>
          <p class="mt-2 text-white/80">
            Envíame tu rubro, nombre del negocio y WhatsApp. Te digo el modelo ideal y el precio.
          </p>
        </div>

        <a
          href="https://wa.me/51946182531?text=Hola%20Victor,%20quiero%20mi%20p%C3%A1gina%20web%20profesional"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center bg-white text-[#0B1A2D] font-extrabold px-6 py-3 rounded-xl hover:opacity-90 transition whitespace-nowrap"
        >
          Empezar por WhatsApp
        </a>
      </div>
    </section>
  </main>


