<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const PHRASES = [
      "Fabricamos tu letrero",
      "Instalamos tu marca",
      "Diseñamos tu publicidad",
      "Fabricamos tu letrero",
      "Imprimimos tus ideas",
    ];

    // ✅ asegúrate que existan
    const phraseEl = document.getElementById("heroPhrase");
    const wipeEl = document.querySelector(".hero-wipe");

    if (!phraseEl || !wipeEl) {
      console.warn("No se encontró #heroPhrase o .hero-wipe");
      return;
    }

    let index = 0;

    const CHANGE_EVERY = 3500; // ⏱️ cambia aquí (ms)
    const WIPE_MS = 1750;       // ⚡ velocidad wipe (ms)

    function nextPhrase() {
      // 1) tapa
      wipeEl.style.transition = `clip-path ${WIPE_MS}ms cubic-bezier(.2,.9,.2,1)`;
      wipeEl.style.clipPath = "inset(0 0 0 0)";

      // 2) cambia texto cuando está tapado
      setTimeout(() => {
        index = (index + 1) % PHRASES.length;
        phraseEl.textContent = PHRASES[index];

        // 3) destapa desde la derecha
        wipeEl.style.transition = `clip-path ${WIPE_MS}ms cubic-bezier(.2,.9,.2,1)`;
        wipeEl.style.clipPath = "inset(0 0 0 100%)";
      }, WIPE_MS);
    }

    // estado inicial: destapado
    wipeEl.style.clipPath = "inset(0 0 0 100%)";

    setInterval(nextPhrase, CHANGE_EVERY);
  });
</script>









