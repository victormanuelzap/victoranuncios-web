  <script
    src="https://cdn.jsdelivr.net/npm/@splidejs/splide@3.1.4/dist/js/splide.min.js"
    defer
  ></script>

  <script is:raw>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof Splide === 'undefined') return;

    const slide1 = new Splide('.splide-desktop', { type: 'loop', autoplay: true, rewind: true });
    const slide2 = new Splide('.splide-mobile', { type: 'loop', autoplay: true, rewind: true });

    slide1.mount();
    slide2.mount();
  });
</script>


