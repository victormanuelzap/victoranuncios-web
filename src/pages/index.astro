<!doctype html>
<html lang="es-PE">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Letrero Luminoso | Victor Anuncios</title>

  <!-- IMPORTANTE: base apunta al repo de proyecto -->
  <base href="/victoranuncios/">

  <!-- Tailwind (opcional para replicar tus clases; si ya tienes tu CSS, reemplázalo) -->
  <script src="https://cdn.tailwindcss.com"></script>

  <meta name="description" content="Letrero luminoso: diseño, fabricación e instalación en Arequipa. Victor Anuncios.">
  <meta name="theme-color" content="#0b1a2b">
</head>
<body class="bg-white text-gray-900">
  <!-- HERO -->
  <section class="w-full overflow-hidden">
    <picture>
      <source srcset="images/slider/hero-mobile.jpg" media="(max-width: 768px)" />
      <img
        src="images/slider/banner-1.jpg"
        alt="Letreros 3D Victor Anuncios"
        class="block w-full h-[46vh] md:h-[70vh] object-cover object-left md:object-center"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </section>

  <!-- PRODUCTOS -->
  <section id="productos" class="max-w-7xl mx-auto px-4 pt-8">
    <div class="flex justify-start">
      <h2 class="text-sm font-extrabold tracking-widest text-blue-700">NUESTROS PRODUCTOS</h2>
    </div>

    <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      <!-- Letrero Luminoso -->
      <a href="servicios/letrero-luminoso/" class="group block">
        <article class="bg-white rounded-2xl shadow-sm ring-1 ring-gray-100 hover:shadow-md transition overflow-hidden">
          <div class="p-4">
            <div class="aspect-[2/3] w-full overflow-hidden rounded-xl bg-gray-50">
              <!-- Si este nombre tiene espacios, renómbralo a 5-min-1.png -->
              <img
                src="assets/images/cards/5-min 1.png"
                alt="Letrero luminoso"
                class="h-full w-full object-contain group-hover:scale-[1.02] transition"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="mt-4">
              <h3 class="text-base md:text-lg font-extrabold text-gray-800 leading-tight">Letrero Luminoso</h3>
              <p class="text-[13px] text-gray-500">Diseño, fabricación e instalación</p>
            </div>
            <div class="mt-4">
              <div class="w-full text-center text-white text-[15px] font-semibold bg-red-600 hover:bg-red-700 px-4 py-3 rounded-xl">
                Ver más
              </div>
            </div>
          </div>
        </article>
      </a>

      <!-- Letrero 3D -->
      <a href="servicios/3d/" class="group block">
        <article class="bg-white rounded-2xl shadow-sm ring-1 ring-gray-100 hover:shadow-md transition overflow-hidden">
          <div class="p-4">
            <div class="aspect-[2/3] w-full overflow-hidden rounded-xl bg-gray-50">
              <img
                src="assets/images/cards/10-min-1.png"
                alt="Letrero 3D"
                class="h-full w-full object-contain group-hover:scale-[1.02] transition"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="mt-4">
              <h3 class="text-base md:text-lg font-extrabold text-gray-800 leading-tight">Letrero 3D</h3>
              <p class="text-[13px] text-gray-500">Diseño, fabricación e instalación</p>
            </div>
            <div class="mt-4">
              <div class="w-full text-center text-white text-[15px] font-semibold bg-red-600 hover:bg-red-700 px-4 py-3 rounded-xl">
                Ver más
              </div>
            </div>
          </div>
        </article>
      </a>

      <!-- Tarjetas -->
      <a href="tarjetas/" class="group block">
        <article class="bg-white rounded-2xl shadow-sm ring-1 ring-gray-100 hover:shadow-md transition overflow-hidden">
          <div class="p-4">
            <div class="aspect-[2/3] w-full overflow-hidden rounded-xl bg-gray-50">
              <img
                src="assets/card-images/tarjeta-presentacion.jpg"
                alt="Tarjetas personales"
                class="h-full w-full object-contain group-hover:scale-[1.02] transition"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="mt-4">
              <h3 class="text-base md:text-lg font-extrabold text-gray-800 leading-tight">Tarjetas Personales</h3>
              <p class="text-[13px] text-gray-500">Diseño e impresión</p>
            </div>
            <div class="mt-4">
              <div class="w-full text-center text-white text-[15px] font-semibold bg-red-600 hover:bg-red-700 px-4 py-3 rounded-xl">
                Ver más
              </div>
            </div>
          </div>
        </article>
      </a>

      <!-- Volantes -->
      <a href="volantes/" class="group block">
        <article class="bg-white rounded-2xl shadow-sm ring-1 ring-gray-100 hover:shadow-md transition overflow-hidden">
          <div class="p-4">
            <div class="aspect-[2/3] w-full overflow-hidden rounded-xl bg-gray-50">
              <img
                src="assets/images/cards/2-min-1.png"
                alt="Volantes publicitarios"
                class="h-full w-full object-contain group-hover:scale-[1.02] transition"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="mt-4">
              <h3 class="text-base md:text-lg font-extrabold text-gray-800 leading-tight">Volantes Publicitarios</h3>
              <p class="text-[13px] text-gray-500">Diseño e impresión</p>
            </div>
            <div class="mt-4">
              <div class="w-full text-center text-white text-[15px] font-semibold bg-red-600 hover:bg-red-700 px-4 py-3 rounded-xl">
                Ver más
              </div>
            </div>
          </div>
        </article>
      </a>
    </div>
  </section>
</body>
</html>
