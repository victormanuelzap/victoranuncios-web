  import Layout from '../layouts/LayoutWELDING.astro'

  // Base correcta para local / GitHub Pages
  const BASE = import.meta.env.BASE_URL

  // Carpeta de assets
  // En tu PC: public/assets/welding_SAC/
  // En la web: /assets/welding_SAC/...
  const ASSETS =
    BASE === '/'
      ? '/assets/welding_SAC'
      : '/victoranuncios-web/assets/welding_SAC'

  // =========================
  // CONFIG GALERÍA
  // =========================
  const TOTAL_IMGS = 54
  const prefix = 'soldaduraA' // <-- si tus fotos se llaman distinto, cambia esto
  const fotos = Array.from({ length: TOTAL_IMGS }, (_, i) => {
    const n = i + 1
    return {
      id: n,
      src: `${ASSETS}/${prefix}${n}.webp`,
      alt: `Trabajo de soldadura y estructuras metálicas - ${n}`,
    }
  })

  // WhatsApp
  const WA_NUMBER = '51952489645'
  const waBase = `https://wa.me/${WA_NUMBER}`
  const waText = (t: string | number | boolean) => `${waBase}?text=${encodeURIComponent(t)}`
  ---

  <Layout
    title="Estructuras metálicas Arequipa | Proyectos deportivos - Metal Welding SRL"
    description="Estructuras metálicas en Arequipa para proyectos deportivos, techos y coberturas. Metal Welding SRL: fabricación, montaje y soldadura profesional. Cotiza por WhatsApp."
    keywords="estructuras metálicas Arequipa, proyectos deportivos Arequipa, soldadura Arequipa, metal welding"
    canonical="https://victoranuncios.com/metal-welding-srl/"
  >

  <section class="mwHero" id="inicio">
    <div class="mwHeroBg">
      <img
        class="mwHeroImg"
        src={`${ASSETS}/PORTADA/portada.webp`}
        alt="Soldadura y estructuras metálicas en Arequipa"
        loading="eager"
        decoding="async"
      />
      <div class="mwHeroShade"></div>
      <div class="mwHeroVignette"></div>
    </div>

    <div class="mwHeroInner">
      <div class="mwHeroCenter reveal">
      

        <div class="mwHeroContent">
  <div class="mwBadge">Calidad de soldadura • Trabajo garantizado</div>
  <h1 class="mwH1center">
  Estructuras metálicas en <span class="mwAccent">Arequipa</span> – Fabricación y montaje
</h1>

    <p class="mwPcenter">
      Fabricación, refuerzo y montaje de estructuras metálicas,
      techos, coberturas, cerchas y barandas.
    </p>

    <div class="mwHeroBtnsCenter">
      <a class="mwBtnPrimary" href={waText('Hola, quiero cotizar un trabajo de soldadura / estructura metálica.')} target="_blank" rel="noopener">
    Cotizar por WhatsApp →
  </a>

    <a class="mwBtnGhost" href="#galeria">
    Ver galería ↓
  </a>

    </div>

  </div>

      </div>
    </div>

    <div class="mwHeroFade"></div>
  </section>





  


    <main class="bg-[#0B0F16] text-white">
      <!-- SERVICIOS + OBRAS RECIENTES (PC: 2 columnas / Móvil: solo servicios) -->
  <section id="servicios" class="max-w-[1250px] mx-auto px-6 pt-14 pb-12">
    <div class="mwServicesGrid">
      <!-- IZQUIERDA: SERVICIOS -->
      <div>
        <div class="reveal">
          <h2 class="text-3xl md:text-4xl font-extrabold">Servicios principales</h2>
