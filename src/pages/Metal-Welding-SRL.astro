          <div>
            <h2 class="text-3xl md:text-4xl font-extrabold">Galería de trabajos</h2>
            <p class="mt-3 text-white/70 max-w-2xl">
              Más de {TOTAL_IMGS} fotos. Haz clic para ver en grande y pedir cotización por WhatsApp.
            </p>
          </div>

          <a
            href={waText('Hola, vi su galería y quiero cotizar un trabajo. ¿Me indicas qué datos enviar?')}
            target="_blank"
            rel="noopener"
            class="btnGhost2"
          >
            Cotizar desde la galería →
          </a>
        </div>

        <!-- Masonry -->
        <div class="mt-8 masonry">
          {fotos.map((f) => (
