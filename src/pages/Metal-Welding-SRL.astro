  /* =========================
    HERO CON PORTADA REAL (SIN OVERLAY AZUL)
  ========================= */
  .mwHero{
    position:relative;
    overflow:hidden;
    background:#05070C;
    min-height: clamp(520px, 72vh, 760px);
  }

  .mwHeroBg{ position:absolute; inset:0; }

  .mwHeroImg{
    position:absolute; inset:0;
    width:100%; height:100%;
    object-fit:cover;
    transform: scale(1.01);
    filter: saturate(1.08) contrast(1.08);
  }

  /* NUEVO: oscurecido neutro (sin azul) */
  .mwHeroShade{
    position:absolute; inset:0;
    background:
      linear-gradient(
        180deg,
        rgba(5,7,12,.25) 0%,
        rgba(5,7,12,.55) 45%,
        rgba(5,7,12,.86) 100%
      );
  }

  .mwHeroVignette{
    position:absolute; inset:-2px;
    background: radial-gradient(circle at 50% 35%, transparent 0%, rgba(0,0,0,.45) 70%, rgba(0,0,0,.78) 100%);
    pointer-events:none;
  }

