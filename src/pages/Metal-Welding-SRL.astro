                onerror="this.style.display='none'"
              />
              <div class="shotOverlay">
                <div class="shotTag">Foto {f.id}</div>
                <div class="shotHint">Ver en grande</div>
              </div>
            </button>
          ))}
        </div>
      </section>

      <!-- CONTACTO / CTA FINAL -->
      <section id="contacto" class="max-w-[1250px] mx-auto px-6 pb-16">
        <div class="reveal finalCta">
          <div>
            <h2 class="text-2xl md:text-3xl font-extrabold">
              ¿Listo para cotizar tu estructura?
            </h2>
            <p class="mt-2 text-white/75 max-w-2xl">
              Envíanos una foto del lugar y medidas aproximadas. Si ya tienes plano, mejor.
            </p>

            <div class="mt-5 flex flex-col sm:flex-row gap-3">
              <a
                href={waText('Hola, quiero cotizar. Tengo foto/medidas del proyecto.')}
                target="_blank"
                rel="noopener"
                class="btnPrimary"
              >
                Escribir por WhatsApp →
              </a>
              <a
                href="#galeria"
                class="btnGhost"
              >
                Volver a la galería ↑
              </a>
            </div>

            <div class="mt-6 text-sm text-white/60">
              WhatsApp: <span class="text-white font-semibold">952 489 645</span>
            </div>
          </div>

          <div class="finalSide">
            <div class="fsTitle">Recomendado para cotizar rápido</div>
            <ul class="fsList">
              <li>Medidas (ancho, largo, alto)</li>
              <li>Ubicación del trabajo</li>
              <li>Foto o video del área</li>
              <li>Tipo de cobertura (si aplica)</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- FOOTER (pocas partes, limpio) -->
      <footer class="border-t border-white/10 bg-black/30">
        <div class="max-w-[1250px] mx-auto px-6 py-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div>
            <div class="text-white font-extrabold">METAL WELDING SRL</div>
            <div class="text-white/60 text-sm mt-1">
              Estructuras metálicas • Soldadura • Montaje en obra
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href={waText('Hola, quiero cotizar un trabajo de soldadura / estructura metálica.')}
              target="_blank"
              rel="noopener"
              class="footerBtn"
            >
              WhatsApp: 952 489 645
            </a>

            <a href="#servicios" class="footerLink">Servicios</a>
            <a href="#galeria" class="footerLink">Galería</a>
            <a href="#contacto" class="footerLink">Contacto</a>
          </div>
        </div>
      </footer>
    </main>

    <!-- MODAL / LIGHTBOX (simple y rápido) -->
    <div id="mw-modal" class="fixed inset-0 z-[999] hidden">
      <div id="mw-backdrop" class="absolute inset-0 bg-black/80"></div>

      <div class="relative w-full h-full flex items-center justify-center p-4">
        <div class="relative max-w-6xl w-full">
          <div class="absolute -top-3 right-0 flex items-center gap-2">
            <a
              id="mw-wa"
              href={waBase}
              target="_blank"
              rel="noopener"
              class="mBtn"
              aria-label="Cotizar por WhatsApp"
            >
              Cotizar
            </a>

            <button
              id="mw-close"
              type="button"
              class="mBtn mX"
              aria-label="Cerrar"
            >
              ×
            </button>
          </div>

          <img
            id="mw-img"
            src=""
            alt="Vista ampliada"
            class="w-full max-h-[82vh] object-contain rounded-2xl bg-black/20 border border-white/10"
          />

          <div class="mt-3 flex items-center justify-between text-sm text-white/70">
            <div id="mw-caption"></div>
            <div class="hidden sm:block">Tip: ESC para cerrar</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Reveal -->
    <script is:inline>
      (function () {
        const els = document.querySelectorAll('.reveal');
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add('is-visible')),
          { threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>

    <!-- Modal -->
    <script is:inline>
      (function () {
        const modal = document.getElementById('mw-modal');
        const img = document.getElementById('mw-img');
        const closeBtn = document.getElementById('mw-close');
        const backdrop = document.getElementById('mw-backdrop');
        const caption = document.getElementById('mw-caption');
        const wa = document.getElementById('mw-wa');

        function openModal(src, alt, id) {
          if (!modal || !img) return;
          img.src = src;
          img.alt = alt || 'Vista ampliada';
          if (caption) caption.textContent = (id ? `Foto ${id}` : '') + (alt ? ` • ${alt}` : '');

          // WhatsApp con referencia de foto
          if (wa) {
            const text = `Hola, vi la Foto ${id || ''} en la galería y quiero cotizar un trabajo similar.`;
            wa.href = `https://wa.me/51952489645?text=${encodeURIComponent(text)}`;
          }

          modal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }

        function closeModal() {
          if (!modal || !img) return;
          modal.classList.add('hidden');
          img.src = '';
          document.body.style.overflow = '';
        }

        document.querySelectorAll('.shot').forEach((b) => {
          b.addEventListener('click', () => {
            const src = b.getAttribute('data-src');
            const alt = b.getAttribute('data-alt');
            const id = b.getAttribute('data-id');
            if (src) openModal(src, alt, id);
          });
        });

        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        if (backdrop) backdrop.addEventListener('click', closeModal);
        document.addEventListener('keydown', (e) => e.key === 'Escape' && closeModal());
      })();
    </script>

    <style is:global>
      /* Reveal */
      .reveal { opacity: 0; transform: translateY(14px); transition: opacity 650ms ease, transform 650ms ease; }
      .reveal.is-visible { opacity: 1; transform: translateY(0); }
      @media (prefers-reduced-motion: reduce) {
        .reveal, .reveal.is-visible { transition: none !important; transform: none !important; opacity: 1 !important; }
      }

