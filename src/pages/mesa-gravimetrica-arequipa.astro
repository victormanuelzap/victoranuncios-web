---
import Layout from "../layouts/Layout.astro";

const title = "Mesa gravimétrica en Arequipa | Venta y cotización";
const description = "Cotiza una mesa gravimétrica en Arequipa para concentración de minerales. Mira fotos y video del equipo y consulta precio y disponibilidad por WhatsApp.";
const canonical = "https://victoranuncios.com/mesa-gravimetrica-arequipa/";
const media = `${import.meta.env.BASE_URL}mesa-gravimetrica-media`;
const message = "Hola, quiero cotizar una mesa gravimétrica. Mi mineral es ____ y necesito procesar ____ kg/h. Estoy en ____.";
const whatsappCotizaciones = "https://wa.me/51995047068?text=" + encodeURIComponent(message);
const whatsappVictor = "https://wa.me/51946182531?text=" + encodeURIComponent(message);
---
<Layout title={title} description={description} canonical={canonical}>
  <div class="bg-slate-50 font-sans text-slate-700">
    <svg class="absolute h-0 w-0" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <symbol id="whatsapp-icon" viewBox="0 0 24 24">
        <path fill="currentColor" d="M12 2a10 10 0 0 0-8.7 15L2 22l5.1-1.3A10 10 0 1 0 12 2Zm0 1.8a8.2 8.2 0 1 1-4.2 15.2l-.3-.2-3 .8.8-3-.2-.3A8.2 8.2 0 0 1 12 3.8Zm-3.5 3.7c-.3 0-.5.1-.7.3-.3.3-.9.8-.9 2 0 1.1.8 2.3 1 2.5.1.2 1.6 2.5 4 3.5.6.3 1.2.5 1.7.6.7.2 1.4.1 1.9 0 .6-.1 1.4-.8 1.6-1.3.2-.5.2-1 .1-1.1l-.5-.3-1.9-.9c-.3-.1-.4-.2-.6.1l-.9 1c-.1.2-.3.2-.5.1-1.4-.6-2.5-1.5-3.3-2.9-.1-.2 0-.4.1-.5l.5-.6c.1-.2.2-.4.1-.6l-.8-1.9c-.2-.4-.4-.4-.6-.4h-.3Z"/>
      </symbol>
    </svg>
    <div class="wrap pb-12">
      <section class="grid items-center gap-8 py-10 md:grid-cols-2 md:py-14">
        <div>
          <p class="mb-3 text-sm font-semibold text-blue-600">Equipos para concentración de minerales</p>
          <h1 class="mb-4 text-3xl font-bold text-slate-900 md:text-4xl">Mesa gravimétrica en Arequipa</h1>
          <p class="mb-5 text-slate-600">Cotiza una mesa concentradora para separar partículas minerales por diferencia de densidad. Consulta el precio, la disponibilidad y qué incluye el equipo.</p>
          <a class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-5 py-3 font-semibold text-white hover:bg-blue-700" href="#cotizar">Cotizar por WhatsApp</a>
        </div>
        <img class="h-auto w-full rounded-3xl shadow-lg" src={media + "/estructura.webp"} width="1440" height="810" alt="Vista lateral de la estructura roja y el mecanismo de la mesa gravimétrica" fetchpriority="high" />
      </section>
      <section id="equipo" class="scroll-mt-24 py-6">
        <h2 class="mb-4 text-2xl font-bold text-slate-900 md:text-3xl">Fotos y video de la mesa gravimétrica</h2>
        <div class="grid gap-5 md:grid-cols-2">
          <figure class="overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-lg"><img class="h-72 w-full bg-slate-100 object-contain md:h-96" src={media + "/detalle.webp"} alt="Vista frontal de la estructura metálica de la mesa concentradora" width="720" height="961" loading="lazy" /><figcaption class="px-5 py-3 text-sm text-slate-600">Vista frontal de la estructura</figcaption></figure>
          <figure class="overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-lg"><video class="h-72 w-full bg-slate-900 object-contain md:h-96" controls playsinline preload="none" poster={media + "/video.webp"} aria-label="Video de la superficie de trabajo"><source src={media + "/mesa.mp4"} type="video/mp4" /></video><figcaption class="px-5 py-3 text-sm text-slate-600">Video de la superficie de trabajo</figcaption></figure>
        </div>
      </section>
      <section class="py-10">
        <h2 class="mb-4 text-2xl font-bold text-slate-900 md:text-3xl">Antes de cotizar</h2>
        <details class="border-t border-slate-200 py-3"><summary class="cursor-pointer font-semibold text-slate-900">¿Para qué sirve una mesa gravimétrica?</summary><p>En la concentración de minerales, una mesa gravimétrica usa el movimiento de la superficie y el flujo de agua para separar partículas de distinta densidad. El resultado depende de las características del material y de su granulometría.</p></details>
        <details class="border-t border-slate-200 py-3"><summary class="cursor-pointer font-semibold text-slate-900">¿Qué incluye el equipo y cuánto cuesta?</summary><p>Consulta el precio, las dimensiones, la capacidad y los componentes incluidos por WhatsApp.</p></details>
      </section>
      <section class="scroll-mt-24 rounded-3xl border border-blue-100 bg-blue-50 p-6 md:p-10" id="cotizar">
        <h2 class="mb-4 text-2xl font-bold text-slate-900 md:text-3xl">Solicita una cotización</h2>
        <p>Indica qué mineral quieres concentrar, cuántos kilos por hora necesitas procesar y en qué distrito o ciudad estás.</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-5 py-3 font-semibold text-white hover:bg-blue-700" href={whatsappCotizaciones} aria-label="WhatsApp 995 047 068"><svg class="h-5 w-5 shrink-0" aria-hidden="true"><use href="#whatsapp-icon" /></svg>995 047 068</a>
          <a class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-5 py-3 font-semibold text-white hover:bg-blue-700" href={whatsappVictor} aria-label="WhatsApp 946 182 531"><svg class="h-5 w-5 shrink-0" aria-hidden="true"><use href="#whatsapp-icon" /></svg>946 182 531</a>
        </div>
      </section>
    </div>
    </div>
</Layout>
