---
import Layout from "../../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;
const whatsapp = "946182531";
const waBase = "https://wa.me/51" + whatsapp;

const CATEGORIES = [
  { key: "all", label: "Todos" },
  { key: "racing", label: "Deportivo / Racing" },
  { key: "brands", label: "Marcas" },
  { key: "redbull", label: "Red Bull" },
  { key: "rockstar", label: "Rockstar" },
  { key: "custom", label: "Personalizado" },
];

const DESIGNS = [
  {
    title: "Kit Fox Racing Honda",
    category: "racing",
    desc: "Diseño agresivo en rojo, negro y blanco.",
    img: "motos/designs/fox-honda.jpg",
    tags: ["Rojo", "Negro", "Blanco"],
  },
  {
    title: "Kit Rockstar Energy #16",
    category: "rockstar",
    desc: "Ideal para motos deportivas.",
    img: "motos/designs/rockstar-16.jpg",
    tags: ["Rojo", "Blanco", "Azul"],
  },
  {
    title: "Kit Red Bull Racing",
    category: "redbull",
    desc: "Diseño profesional con patrocinadores.",
    img: "motos/designs/redbull-01.jpg",
    tags: ["Azul", "Rojo", "Blanco"],
  },
];
---

<Layout
  title="Stickers para motos en Arequipa | Victor Anuncios"
  description="Diseños de stickers para motos en Arequipa. Kits racing, marcas y personalizados."
  canonical="https://www.victoranuncios.com/stickers-motos/"
>
  <main class="min-h-screen bg-slate-950 text-white">

    <!-- HERO -->
    <section class="relative">
      <div class="absolute inset-0">
        <img
          src={base + "motos/hero-moto.jpg"}
          class="h-[420px] w-full object-cover md:h-[520px]"
          alt="Stickers para motos"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/60 to-slate-950/20"></div>
      </div>

      <div class="relative mx-auto max-w-6xl px-4 py-20">
        <h1 class="text-4xl md:text-6xl font-extrabold">
          Stickers para Motos en Arequipa
        </h1>

        <p class="mt-4 text-lg text-slate-200 max-w-2xl">
          Personaliza tu moto con kits racing, marcas y diseños exclusivos.
        </p>

        <div class="mt-8">
          <a
            href={waBase + "?text=Hola quiero stickers para mi moto"}
            class="bg-white text-slate-900 px-6 py-3 rounded-xl font-bold"
            target="_blank"
          >
            🟢 WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- CONTENIDO -->
    <section class="mx-auto max-w-6xl px-4 pb-16">

      <!-- COMO FUNCIONA -->
      <section class="mt-12 bg-slate-900/40 p-8 rounded-3xl border border-white/10">
        <h2 class="text-3xl font-bold">¿Cómo funciona?</h2>
        <ol class="mt-6 space-y-2 text-slate-200">
          <li>1. Elige tu diseño</li>
          <li>2. Escríbenos por WhatsApp</li>
          <li>3. Agenda tu instalación</li>
          <li>4. Personalizamos tu moto</li>
        </ol>
      </section>

      <!-- GALERIA -->
      <section id="galeria" class="mt-14">
        <h2 class="text-3xl font-bold mb-6">Galería de Diseños</h2>

        <div class="grid md:grid-cols-3 gap-6">
          {DESIGNS.map((d) => (
            <article class="bg-white text-slate-900 rounded-3xl overflow-hidden shadow-xl">
              <img src={base + d.img} class="h-64 w-full object-cover" />
              <div class="p-5">
                <h3 class="text-xl font-bold">{d.title}</h3>
                <p class="mt-2 text-sm text-slate-600">{d.desc}</p>

                <a
                  href={waBase + "?text=" + encodeURIComponent("Hola quiero este diseño: " + d.title)}
                  target="_blank"
                  class="mt-4 inline-block bg-slate-900 text-white px-4 py-2 rounded-xl text-sm font-bold"
                >
                  Pedir por WhatsApp
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- TRANSFORMACIONES -->
      <section class="mt-16 bg-slate-900/30 p-8 rounded-3xl border border-white/10">
        <div class="text-center">
          <h2 class="text-4xl font-extrabold">Transformaciones Reales</h2>
          <p class="mt-2 text-slate-300">
            Arrastra el divisor para ver el antes y después
          </p>
        </div>

        <div class="mt-8 relative h-[400px] rounded-3xl overflow-hidden">
          <img src={base + "motos/before.jpg"} class="absolute inset-0 w-full h-full object-cover" />
          <div id="afterWrap" class="absolute inset-0 w-1/2 overflow-hidden">
            <img src={base + "motos/after.jpg"} class="w-full h-full object-cover" />
          </div>

          <input id="range" type="range" min="0" max="100" value="50"
            class="absolute bottom-4 left-1/2 -translate-x-1/2 w-[80%]" />
        </div>

        <script is:inline>
          const range = document.getElementById("range");
          const afterWrap = document.getElementById("afterWrap");

          function sync() {
            afterWrap.style.width = range.value + "%";
          }

          range.addEventListener("input", sync);
          sync();
        </script>
      </section>

      <!-- DELIVERY -->
      <section class="mt-16 bg-gradient-to-r from-purple-800/40 to-indigo-900/40 p-8 rounded-3xl border border-white/10 text-center">
        <h2 class="text-3xl font-bold">¿No puedes traer tu moto?</h2>
        <p class="mt-4 text-slate-200">
          Envíanos las carcasas y te las devolvemos con delivery.
        </p>

        <div class="mt-6">
          <a
            href={waBase + "?text=Hola quiero delivery para stickers"}
            target="_blank"
            class="bg-white text-slate-900 px-6 py-3 rounded-xl font-bold"
          >
            Solicitar Delivery
          </a>
        </div>
      </section>

      <!-- CTA FINAL -->
      <section class="mt-16 bg-gradient-to-r from-purple-800/30 to-indigo-900/30 p-10 rounded-3xl border border-white/10 text-center">
        <h2 class="text-4xl font-extrabold">¿Tienes una idea personalizada?</h2>
        <p class="mt-4 text-slate-200">
          Cuéntanos tu idea y la hacemos realidad.
        </p>

        <div class="mt-6">
          <a
            href={waBase + "?text=Hola quiero un diseño personalizado"}
            target="_blank"
            class="bg-purple-600 text-white px-8 py-4 rounded-2xl font-extrabold"
          >
            Solicitar Diseño Personalizado
          </a>
        </div>
      </section>

    </section>

    <!-- FOOTER STICKERS (como tu captura) -->
    <footer class="mt-16 border-t border-white/10 bg-slate-950/70 py-12">
      <div class="mx-auto max-w-6xl px-4 text-center">
        <div class="mx-auto mb-4 grid h-14 w-14 place-items-center rounded-2xl bg-white">
          <img src={base + "logo.png"} alt="Victor Anuncios" class="h-8 w-8" />
        </div>

        <p class="text-xl font-bold">Victor Anuncios</p>
        <p class="mt-2 text-slate-300">Stickers para motos en Arequipa, Perú</p>

        <p class="mt-6 text-slate-400">
          © 2026 Victor Anuncios - Diseños de Stickers para Motos. Todos los derechos reservados.
        </p>

        <div class="mt-6 flex justify-center gap-8 text-lg font-bold">
          <a
            class="text-pink-400 hover:underline"
            href="https://www.instagram.com/victoranuncioss/"
            target="_blank"
            rel="noreferrer"
          >
            Instagram
          </a>

          <a
            class="text-blue-400 hover:underline"
            href="https://www.facebook.com/VictorAnunciosarequipa"
            target="_blank"
            rel="noreferrer"
          >
            Facebook
          </a>

          <a
            class="text-green-400 hover:underline"
            href={waBase}
            target="_blank"
            rel="noreferrer"
          >
            WhatsApp
          </a>
        </div>
      </div>
    </footer>

  </main>
</Layout>
