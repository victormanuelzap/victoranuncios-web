    ],
  },
  {
    title: 'Tarjeta personal',
    title_2: 'Repujado',
    image: `${base}assets/images/tarjetas-5.png`,
    whatsapp: `https://wa.me/${number}?text=Hola, quiero una tarjeta personal repujada`,
    features: [
      { name: 'Material', value: 'Papel couche de 350 gr' },
