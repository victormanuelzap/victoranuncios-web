---
import Layout from '../layouts/Layout.astro'

const base = import.meta.env.BASE_URL
const number = '51946182531'

const products = [
    {
        title: 'Calendario de pared',
        title_2: 'FoldCote C-12',
        image: `${base}assets/images/calendario-1.png`,
        whatsapp: `https://wa.me/${number}?text=Hola, quiero información sobre calendarios de pared FoldCote C-12`,
        features: [
            { name: 'Material', value: 'FoldCote C-12' },
            { name: 'Medidas', value: '50 x 70 cm / 50 x 35 cm / 25 x 35 cm' },
            { name: 'Impresión', value: 'Full color T/R' },
            { name: 'Acabado', value: 'Plastificado Brillante o Mate' },
            { name: 'Extras', value: 'Perforado GRATIS + Tira' },
        ],
    },

    {
        title: 'Calendario de pared',
        title_2: 'FoldCote C-14',
        image: `${base}assets/images/calendario-2.png`,
        whatsapp: `https://wa.me/${number}?text=Hola, quiero información sobre calendarios de pared FoldCote C-14`,
        features: [
            { name: 'Material', value: 'FoldCote C-14' },
            { name: 'Medidas', value: '50 x 70 cm / 50 x 35 cm / 25 x 35 cm' },
            { name: 'Impresión', value: 'Full color T/R' },
            { name: 'Acabado', value: 'Plastificado Brillante o Mate' },
            { name: 'Extras', value: 'Perforado GRATIS + Tira' },
        ],
    },

    {
        title: 'Calendario de pared',
        title_2: 'FoldCote C-16',
        image: `${base}assets/images/calendario-3.png`,
        whatsapp: `https://wa.me/${number}?text=Hola, quiero información sobre calendarios de pared FoldCote C-16`,
        features: [
            { name: 'Material', value: 'FoldCote C-16' },
            { name: 'Medidas', value: '50 x 70 cm / 50 x 35 cm / 25 x 35 cm' },
            { name: 'Impresión', value: 'Full color T/R' },
            { name: 'Acabado', value: 'Plastificado Brillante o Mate' },
            { name: 'Extras', value: 'Perforado GRATIS + Tira' },
        ],
    },
]
---

<Layout title='Calendarios de pared (Arequipa) - victor anuncios'>

    <section class='relative'>
        <img
            src={`${base}assets/images/calendarios-pared.png`}
            class='h-80 w-full object-cover'
        />

        <div class='absolute top-0 left-0 w-full h-full bg-black bg-opacity-50 flex justify-center items-center'>
            <h1 class='text-white text-4xl md:text-6xl font-bold uppercase text-center'>
                CALENDARIOS DE PARED
            </h1>
        </div>
    </section>

    <div class='max-w-7xl mx-auto'>
        <div class='grid gap-10 md:grid-cols-3'>

            {
                products.map((product) => (
                    <div>

                        <!-- IMAGEN SIN ABSOLUTE -->
                        <div>
                            <img
                                src={product.image}
                                alt="Calendario de pared"
                                class="w-full h-[260px] object-contain p-2 mx-auto"
                            />
                        </div>

                        <!-- TITULOS DEBAJO DE LA IMAGEN -->
                        <div class="mt-3 leading-6 text-center">
                            <h2 class='font-semibold uppercase text-xl'>
                                {product.title}
                            </h2>

                            <h2 class='font-bold uppercase text-red-500 text-2xl'>
                                {product.title_2}
                            </h2>
                        </div>

                        <!-- CARACTERISTICAS -->
                        <div>
                            <table>
                                {product.features.map((feature) => (
                                    <tr>
                                        <td class='text-red-500 font-semibold'>
                                            {feature.name}:&nbsp;
                                        </td>
                                        <td>{feature.value}</td>
                                    </tr>
                                ))}
                            </table>
                        </div>

                        <!-- BOTON -->

<div class='my-5'>
    <a
        href={product.whatsapp}
        class='bg-blue-600 hover:bg-blue-500 text-white py-2 px-4 rounded-xl w-full flex gap-2 justify-center items-center transition'
    >
        <i class='bx bxl-whatsapp text-2xl' />
        Pedir por WhatsApp
    </a>
</div>




                    </div>
                ))
            }

        </div>
    </div>

</Layout>
