---
import Layout from '../../layouts/Layout.astro'

const diseños = [
  {
    titulo: 'Panadería Panesur',
    rubro: 'Exterior',
    imagen: '/Diseños/imagenes/exterior/panesur01.webp'
  },
  {
    titulo: 'Barbería Brothers',
    rubro: 'Exterior',
    imagen: '/Diseños/imagenes/exterior/barberia01.webp'
  },
  {
    titulo: 'Restaurante Cevichop',
    rubro: 'Interior',
    imagen: '/Diseños/imagenes/interior/cevichop01.webp'
  },
]
---

<Layout title="Diseños — Exterior / Interior">

  <main class="bg-[#E9EAEE] py-10">
    <section class="max-w-6xl mx-auto px-4">

      <h1 class="text-3xl font-bold text-slate-900 mb-6">
        Diseños de Exterior e Interior
      </h1>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">

        {diseños.map((d) => (
          <div class="relative rounded-2xl overflow-hidden shadow-md group">
            <img
              src={d.imagen}
              alt={d.titulo}
              class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition duration-300 flex items-end p-3">
              <div class="text-white text-sm">
                <strong>{d.titulo}</strong><br />
                {d.rubro}
              </div>
            </div>
          </div>
        ))}

      </div>

    </section>
  </main>
</Layout>

