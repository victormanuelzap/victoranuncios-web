---
import ClientLayout from '../layouts/ClientLayout.astro'

const base = import.meta.env.BASE_URL
// Número del cliente: 925 632 333  (formato internacional para enlaces)
const number = '51925632333'

// PRODUCTOS
const products = [
  {
    title: 'Horno artesanal',
    title_2: 'De ladrillo',
    image: `${base}assets/images/hornos-1.jpg`,
    whatsapp: `https://wa.me/${number}?text=Hola, quiero un horno artesanal de ladrillo en Arequipa`,
    features: [
      { name: 'Uso', value: 'Ideal para pan, pizza y carnes' },
      { name: 'Material', value: 'Ladrillo refractario y cemento' },
      { name: 'Medidas', value: 'Se diseña a medida según tu espacio' },
      { name: 'Instalación', value: 'Incluye estructura y base de soporte' },
      { name: 'Zona de atención', value: 'Arequipa y alrededores' },
    ],
  },
  {
    title: 'Horno artesanal',
    title_2: 'De barro tradicional',
    image: `${base}assets/images/hornos-2.jpg`,
    whatsapp: `https://wa.me/${number}?text=Hola, quiero un horno artesanal de barro tradicional en Arequipa`,
    features: [
      { name: 'Estilo', value: 'Domo de barro tipo rústico' },
      { name: 'Uso', value: 'Cocción tradicional para hogar o negocio pequeño' },
      { name: 'Retención de calor', value: 'Excelente conservación de temperatura' },
      { name: 'Instalación', value: 'Se adapta a patios, terrazas y áreas de parrilla' },
      { name: 'Personalización', value: 'Acabados y tamaño a elección' },
    ],
  },
  {
    title: 'Horno artesanal',
    title_2: 'Con base de piedra',
    image: `${base}assets/images/hornos-3.jpg`,
    whatsapp: `https://wa.me/${number}?text=Hola, quiero un horno artesanal con base de piedra en Arequipa`,
    features: [
      { name: 'Estructura', value: 'Base de piedra o ladrillo tipo rústico' },
      { name: 'Uso', value: 'Hogar, restaurantes campestres y negocios de comida' },
      { name: 'Material', value: 'Ladrillo refractario, barro y concreto' },
      { name: 'Instalación', value: 'Incluye chimenea y puerta metálica según diseño' },
      { name: 'Proyecto', value: 'Se puede integrar con parrilla u otros módulos' },
    ],
  },
]
---

<ClientLayout
  title='Hornos artesanales en Arequipa | Fabricación a medida - Victor Anuncios'
  description='Hornos artesanales en Arequipa – Fabricación a medida para casa y negocio. Construimos hornos artesanales de alta calidad, duraderos y eficientes, con instalación profesional.'
  keywords='hornos artesanales Arequipa, hornos de barro Arequipa, hornos de ladrillo, construcción de hornos, hornos para casa, hornos para negocio, hornos rústicos'
  canonical='https://victoranuncios.com/hornos-artesanales'
>
  {/* HERO */}
  <section class='relative'>
    <img
      src={`${base}assets/images/hornos-artesanales-hero.jpg`}
      alt='Hornos artesanales en Arequipa - Hornos Artesanales Arequipa'
      class='h-80 w-full object-cover'
    />

    <div class='absolute top-0 left-0 w-full h-full bg-black bg-opacity-55 flex justify-center items-center'>
      <div class='text-center px-4 max-w-3xl mx-auto'>
        {/* Etiqueta tipo “CREACIÓN” */}
        <div class="inline-block mb-3 px-4 py-1 rounded-full bg-[#FF6A1A] text-white text-xs md:text-sm font-semibold tracking-wide">
          CREACIÓN DE HORNOS ARTESANALES
        </div>

        <h1 class='text-white text-3xl md:text-5xl font-extrabold uppercase mb-2 drop-shadow-xl'>
          HORNOS ARTESANALES AREQUIPA
        </h1>
        <p class='text-white text-sm md:text-lg font-medium drop-shadow mb-3'>
          Fabricación a medida para tu hogar o negocio. Hornos artesanales duraderos y eficientes, listos para pan, pizza y comida tradicional.
        </p>

        {/* Teléfono del negocio */}
        <div class='mt-2 flex flex-col items-center gap-2'>
          <a
            href={`tel:+${number}`}
            class='inline-flex items-center gap-2 bg-[#FF6A1A] hover:bg-[#FF7A30] text-white font-semibold py-2 px-5 rounded-xl shadow-lg transition'
          >
            <i class='bx bx-phone-call text-2xl' />
            Llamar: 925 632 333
          </a>
          <p class='text-xs md:text-sm text-gray-100'>
            Atención en Arequipa y alrededores. También puedes escribir por WhatsApp en cada modelo.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* GRID DE PRODUCTOS */}
  <div class='max-w-7xl mx-auto px-4 py-10'>
    <div class='grid gap-10 md:grid-cols-3'>
      {products.map((product) => (
        <div class='rounded-2xl shadow-lg bg-white overflow-hidden flex flex-col'>
          {/* Imagen y títulos */}
          <div class='relative'>
            <img
              src={product.image}
              alt={`Horno artesanal ${product.title_2} en Arequipa`}
              class='rounded-t-2xl w-full h-64 object-cover group-hover:scale-105 group-hover:rotate-1 transition-all duration-500'
            />
            <div class='leading-6 text-lg absolute bottom-4 w-full text-center drop-shadow'>
              {product.title && (
                <h2 class='font-semibold uppercase text-white tracking-wide'>
                  {product.title}
                </h2>
              )}
              <h2 class='font-extrabold uppercase text-[#FF6A1A]'>
                {product.title_2}
              </h2>
            </div>
          </div>

          {/* Características */}
          <div class='px-4 pt-4 pb-2 flex-1'>
            <table class='text-sm w-full'>
              <tbody>
                {product.features.map((feature) => (
                  <tr>
                    <td class='text-[#FF6A1A] font-semibold align-top pr-1 whitespace-nowrap'>
                      {feature.name}:&nbsp;
                    </td>
                    <td class='text-gray-700'>{feature.value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {/* Botón WhatsApp */}
          <div class='px-4 pb-5 mt-2'>
            <a
              href={product.whatsapp}
              class='bg-green-600 hover:bg-green-500 text-white py-2 px-4 rounded-xl w-full flex gap-2 justify-center items-center transition'
            >
              <i class='bx bxl-whatsapp text-2xl' />
              Pedir información por WhatsApp
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>

  {/* TEXTO SEO INFORMATIVO */}
  <section class='max-w-5xl mx-auto mt-4 mb-16 px-4'>
    <h2 class='text-2xl font-bold mb-3 text-[#A65E2E]'>
      Hornos artesanales en Arequipa – fabricación a medida
    </h2>
    <p class='mb-3 text-gray-700'>
      En Hornos Artesanales Arequipa fabricamos hornos a medida para tu hogar o negocio. Construimos hornos duraderos, eficientes y hechos con materiales de alta calidad, ideales para pan, pizzas, carnes y comida tradicional.
    </p>
    <p class='mb-3 text-gray-700'>
      Te asesoramos en el diseño del horno según el espacio disponible y el uso que necesites: familiar, comercial o mixto. Trabajamos con ladrillo refractario, barro y estructuras reforzadas para lograr una excelente retención de calor y una cocción pareja.
    </p>
    <p class='text-gray-700'>
      Si buscas un horno artesanal en Arequipa, contáctanos por llamada directa al <strong>925 632 333</strong> o por WhatsApp desde los modelos mostrados. Coordinamos medidas, diseño, tiempo de construcción e instalación para que disfrutes pronto del auténtico sabor de horno artesanal.
    </p>
  </section>
</ClientLayout>
