---
import ClientLayout from '../layouts/ClientLayout.astro'

const base = import.meta.env.BASE_URL
const number = '51925632333'

const products = [
  {
    title: 'Horno artesanal',
    title_2: 'De ladrillo',
    image: `${base}assets/images/hornos-1.jpg`,
    whatsapp: `https://wa.me/${number}?text=Hola, quiero un horno artesanal de ladrillo en Arequipa`,
    features: [
      { name: 'Uso', value: 'Ideal para pan, pizza y carnes' },
      { name: 'Material', value: 'Ladrillo refractario y cemento' },
      { name: 'Medidas', value: 'Se diseña a medida según tu espacio' },
      { name: 'Instalación', value: 'Incluye estructura y base de soporte' },
      { name: 'Zona de atención', value: 'Arequipa y alrededores' },
    ],
  },
  {
    title: 'Horno artesanal',
    title_2: 'De barro tradicional',
    image: `${base}assets/images/hornos-2.jpg`,
    whatsapp: `https://wa.me/${number}?text=Hola, quiero un horno artesanal de barro tradicional en Arequipa`,
    features: [
      { name: 'Estilo', value: 'Domo de barro tipo rústico' },
      { name: 'Uso', value: 'Cocción tradicional para hogar o negocio pequeño' },
      { name: 'Retención de calor', value: 'Excelente conservación de temperatura' },
      { name: 'Instalación', value: 'Se adapta a patios, terrazas y áreas de parrilla' },
      { name: 'Personalización', value: 'Acabados y tamaño a elección' },
    ],
  },
  {
    title: 'Horno artesanal',
    title_2: 'Con base de piedra',
    image: `${base}assets/images/hornos-3.jpg`,
    whatsapp: `https://wa.me/${number}?text=Hola, quiero un horno artesanal con base de piedra en Arequipa`,
    features: [
      { name: 'Estructura', value: 'Base de piedra o ladrillo tipo rústico' },
      { name: 'Uso', value: 'Hogar, restaurantes campestres y negocios de comida' },
      { name: 'Material', value: 'Ladrillo refractario, barro y concreto' },
      { name: 'Instalación', value: 'Incluye chimenea y puerta metálica según diseño' },
      { name: 'Proyecto', value: 'Se puede integrar con parrilla u otros módulos' },
    ],
  },
]
---

<ClientLayout
  title="Hornos artesanales en Arequipa | Fabricación a medida - Hornos Artesanales Arequipa"
  description="Hornos artesanales en Arequipa – Fabricación a medida para casa y negocio. Hornos de ladrillo, barro y base de piedra, construidos con materiales de alta calidad."
  keywords="hornos artesanales Arequipa, hornos de barro Arequipa, hornos de ladrillo, construcción de hornos, hornos para casa, hornos para negocio, hornos rústicos"
  canonical="https://www.victoranuncios.com/hornos-artesanales"
>
  <!-- ESPACIADO GENERAL PARA MÓVIL -->
  <main class="pt-4 md:pt-6 pb-10">

<!-- HERO DEFINITIVO -->
<section class="relative px-4 md:px-0 mt-1">
  <div class="w-full relative h-[350px] sm:h-[420px] lg:h-[480px] xl:h-[520px] overflow-hidden">
    
    <!-- Imagen de fondo -->
    <img
      src={`${base}assets/images/hornos-artesanales-hero.jpg`}
      alt="Hornos artesanales en Arequipa - Hornos Artesanales Arequipa"
      class="h-full w-full object-cover"
    />

    <!-- Capa oscura -->
    <div class="absolute inset-0 bg-black bg-opacity-60 flex justify-center items-center">
      <div class="text-center px-2 sm:px-4 max-w-4xl mx-auto">

        <!-- TARJETA LOGO CENTRADA -->
        <div class="flex justify-center mb-3 sm:mb-4 w-full">
          <div class="bg-white/90 rounded-2xl px-3 sm:px-4 py-2.5 sm:py-3 flex items-center gap-2 sm:gap-3 shadow-lg">
            <img
              src={`${base}assets/images/hornos-logo.png`}
              alt="Logo Hornos Artesanales Arequipa"
              class="w-12 h-12 sm:w-16 sm:h-16 object-contain"
            />
            <div class="text-left leading-tight">
              <p class="text-[10px] sm:text-[11px] md:text-xs text-neutral-600 font-semibold uppercase tracking-wide">
                Hornos Artesanales
              </p>
              <p class="text-xs sm:text-sm md:text-base font-bold text-neutral-900">
                HORNOS ARTESANALES AREQUIPA
              </p>
            </div>
          </div>
        </div>

        <!-- CHIP / ETIQUETA -->
        <div class="inline-block mb-2 sm:mb-3 px-3 sm:px-4 py-1 rounded-full bg-[#FF6A1A] text-white text-[11px] sm:text-xs md:text-sm font-semibold tracking-wide">
          CREACIÓN DE HORNOS ARTESANALES
        </div>

        <!-- TÍTULO PRINCIPAL -->
        <h1 class="text-white text-2xl sm:text-3xl md:text-5xl font-extrabold uppercase mb-1.5 sm:mb-2 drop-shadow-xl">
          HORNOS ARTESANALES EN AREQUIPA
        </h1>

        <!-- DESCRIPCIÓN -->
        <p class="text-white text-[12px] sm:text-sm md:text-lg font-medium drop-shadow mb-2.5 sm:mb-3">
          Fabricación a medida para tu hogar o negocio. Hornos artesanales duraderos y eficientes para pan, pizza y comida tradicional.
        </p>

        <!-- BOTÓN DE LLAMADA -->
        <div class="mt-1.5 sm:mt-2 flex flex-col items-center gap-1.5 sm:gap-2">
          <a
            href={`tel:+${number}`}
            class="inline-flex items-center gap-2 bg-[#FF6A1A] hover:bg-[#FF7A30] text-white font-semibold py-2 px-5 rounded-xl shadow-lg transition"
          >
            <i class="bx bx-phone-call text-xl sm:text-2xl"></i>
            Llamar: 925 632 333
          </a>
          <p class="text-[11px] sm:text-xs md:text-sm text-gray-100">
            Atención en Arequipa y alrededores. También puedes escribir por WhatsApp en cada modelo.
          </p>
        </div>

      </div>
    </div>
  </div>
</section>



    <!-- GRID DE PRODUCTOS -->
    <section class="max-w-7xl mx-auto px-4 pt-8 md:pt-10 pb-6 md:pb-10">
      <div class="grid gap-8 md:gap-10 md:grid-cols-3">
        {products.map((product) => (
          <div class="rounded-3xl shadow-lg bg-white overflow-hidden flex flex-col hover:-translate-y-1 hover:shadow-xl transition-transform duration-300 max-w-md mx-auto md:max-w-none">

            <!-- IMAGEN MÁS CUADRADA Y RESPONSIVA -->
            <div class="w-full bg-white flex items-center justify-center">
              <div class="w-full aspect-[4/3] flex items-center justify-center">
                <img
                  src={product.image}
                  alt={product.title_2}
                  class="w-full h-full object-cover"
                />
              </div>
            </div>

            <!-- TÍTULOS -->
            <div class="text-center pt-3 pb-2 px-3 border-b border-gray-100">
              <h2 class="font-semibold uppercase text-gray-800 tracking-wide text-[14px] sm:text-[15px]">
                {product.title}
              </h2>
              <h2 class="font-extrabold uppercase text-[#FF6A1A] text-[16px] sm:text-[17px]">
                {product.title_2}
              </h2>
            </div>

            <!-- CARACTERÍSTICAS -->
            <div class="px-4 pt-4 pb-2 flex-1">
              <table class="text-sm w-full">
                <tbody>
                  {product.features.map((feature) => (
                    <tr>
                      <td class="text-[#FF6A1A] font-semibold align-top pr-1 whitespace-nowrap">
                        {feature.name}:
                      </td>
                      <td class="text-gray-700">{feature.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <!-- BOTÓN WHATSAPP -->
            <div class="px-4 pb-5 mt-2">
              <a
                href={product.whatsapp}
                class="bg-[#FF6A1A] hover:bg-[#FF7A30] text-white py-2 px-4 rounded-xl w-full flex gap-2 justify-center items-center transition shadow-md text-sm sm:text-base"
              >
                <i class="bx bxl-whatsapp text-xl sm:text-2xl"></i>
                Pedir información por WhatsApp
              </a>
            </div>

          </div>
        ))}
      </div>
    </section>

    <!-- TEXTO SEO -->
    <section class="max-w-5xl mx-auto mt-2 mb-6 md:mb-16 px-4">
      <h2 class="text-2xl font-bold mb-3 text-[#A65E2E]">
        Hornos artesanales en Arequipa – fabricación a medida
      </h2>
      <p class="mb-3 text-gray-700">
        En Hornos Artesanales Arequipa fabricamos hornos a medida para tu hogar o negocio...
      </p>
      <p class="mb-3 text-gray-700">
        Trabajamos con ladrillo refractario, barro y estructuras reforzadas...
      </p>
      <p class="text-gray-700">
        Contáctanos por llamada al <strong>925 632 333</strong> o por WhatsApp.
      </p>
    </section>

  </main>

  <!-- JSON-LD FINAL, CORREGIDO -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "https://www.victoranuncios.com/hornos-artesanales#business",
    "name": "Hornos Artesanales Arequipa",
    "description": "Hornos artesanales en Arequipa fabricados a medida para casa y negocio.",
    "url": "https://www.victoranuncios.com/hornos-artesanales",
    "telephone": "+51925632333",
    "image": [
      "https://www.victoranuncios.com/assets/images/hornos-1.jpg",
      "https://www.victoranuncios.com/assets/images/hornos-2.jpg",
      "https://www.victoranuncios.com/assets/images/hornos-3.jpg"
    ],
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Arequipa",
      "addressRegion": "Arequipa",
      "addressCountry": "PE"
    },
    "areaServed": "Arequipa",
    "makesOffer": [
      {
        "@type": "Product",
        "name": "Horno artesanal de ladrillo",
        "image": "https://www.victoranuncios.com/assets/images/hornos-1.jpg",
        "description": "Horno artesanal de ladrillo hecho a medida en Arequipa.",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "PEN",
          "availability": "InStock",
          "url": "https://www.victoranuncios.com/hornos-artesanales"
        }
      },
      {
        "@type": "Product",
        "name": "Horno artesanal de barro tradicional",
        "image": "https://www.victoranuncios.com/assets/images/hornos-2.jpg",
        "description": "Horno de barro tradicional hecho a medida en Arequipa.",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "PEN",
          "availability": "InStock",
          "url": "https://www.victoranuncios.com/hornos-artesanales"
        }
      },
      {
        "@type": "Product",
        "name": "Horno artesanal con base de piedra",
        "image": "https://www.victoranuncios.com/assets/images/hornos-3.jpg",
        "description": "Horno artesanal con base de piedra hecho a medida en Arequipa.",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "PEN",
          "availability": "InStock",
          "url": "https://www.victoranuncios.com/hornos-artesanales"
        }
      }
    ]
  }
  </script>

</ClientLayout>
