---
// src/pages/disenos/[categoria].astro

import '../../css/base.css'
import { categorias, disenos } from '../../data/disenos'

// 🔹 1) Definimos qué rutas dinámicas se deben generar para /disenos/[categoria]
export function getStaticPaths() {
  return categorias.map((cat) => ({
    params: { categoria: cat.slug },
  }))
}

const base = import.meta.env.BASE_URL
const { categoria } = Astro.params

// 🔹 2) Buscar la información de la categoría actual
const categoriaData = categorias.find((cat) => cat.slug === categoria)

if (!categoriaData) {
  throw new Error(`Categoría "${categoria}" no encontrada`)
}

// 🔹 3) Filtrar diseños solo de esta categoría
const disenosFiltrados = disenos.filter((item) => item.categoria === categoria)
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>{categoriaData.nombre} – Victor Anuncios</title>

    <meta
      name="description"
      content={`Diseños de ${categoriaData.nombre} realizados por Victor Anuncios en Arequipa.`}
    />
  </head>

  <body class="bg-slate-100">
    <main class="max-w-6xl mx-auto px-4 py-10">
      <a href={`${base}disenos/`} class="text-sm text-sky-600 hover:underline">
        ← Volver a galería de categorías
      </a>

      <h1 class="mt-4 text-3xl font-extrabold text-slate-900">
        {categoriaData.nombre}
      </h1>

      <p class="mt-2 text-slate-600">
        {categoriaData.descripcion}
      </p>

      <!-- 🔍 4) BUSCADOR PARA FILTRAR DISEÑOS EN ESTA CATEGORÍA -->
      <input
        id="buscador-disenos"
        type="text"
        placeholder="Buscar diseños dentro de esta categoría..."
        class="w-full mt-6 mb-6 px-4 py-3 border rounded-lg shadow-sm"
      />

      <!-- 🔹 5) GRID DE DISEÑOS FILTRADOS POR CATEGORÍA -->
      <section id="grid-disenos" class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {disenosFiltrados.length === 0 ? (
          <p class="text-slate-500 col-span-full">
            Aún no has cargado diseños para esta categoría.
          </p>
        ) : (
          disenosFiltrados.map((item) => (
            <>
              {/* 🔸6) Cada tarjeta tiene data-title para que el buscador la pueda filtrar */}
              <article
                class="dis-item bg-white shadow-md overflow-hidden rounded-none flex flex-col"
                data-title={item.titulo.toLowerCase()}
              >
                <div class="aspect-[4/3] overflow-hidden rounded-none">
                  <img
                    src={item.imagen}
                    alt={item.titulo}
                    loading="lazy"
                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                  />
                </div>
                <div class="p-4 flex-1 flex flex-col">
                  <h2 class="font-semibold text-slate-900">
                    {item.titulo}
                  </h2>
                </div>
              </article>
            </>
          ))
        )}
      </section>

    </main>

    <!-- 🔥 7) SCRIPT DEL BUSCADOR: FILTRA LAS TARJETAS POR TÍTULO -->
    <script is:inline>
      const buscador = document.getElementById("buscador-disenos");
      const items = document.querySelectorAll(".dis-item");

      if (buscador && items.length > 0) {
        buscador.addEventListener("input", () => {
          const q = buscador.value.trim().toLowerCase();

          items.forEach((card) => {
            const title = card.dataset.title || "";

            if (title.includes(q)) {
              card.style.display = "";
            } else {
              card.style.display = "none";
            }
          });
        });
      }
    </script>

  </body>
</html>
