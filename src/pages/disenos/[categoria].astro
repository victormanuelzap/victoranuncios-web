
---
// src/pages/disenos/[categoria].astro
import Layout from '../../layouts/Layout.astro'
import '../../css/base.css'
import { categorias, disenos } from '../../data/disenos'

// 🔹 1) Rutas dinámicas
export function getStaticPaths() {
  return categorias.map((cat) => ({
    params: { categoria: cat.slug },
  }))
}

const base = import.meta.env.BASE_URL
const { categoria } = Astro.params

// 🔹 2) Datos de la categoría actual
const categoriaData = categorias.find((cat) => cat.slug === categoria)

if (!categoriaData) {
  throw new Error(`Categoría "${categoria}" no encontrada`)
}

// 🔹 3) Diseños filtrados por categoría
const disenosFiltrados = disenos.filter((item) => item.categoria === categoria)

// Título y descripción para el Layout
const pageTitle = `${categoriaData.nombre} – Victor Anuncios`
const pageDescription = `Diseños de ${categoriaData.nombre} realizados por Victor Anuncios en Arequipa.`
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Puedes controlar el fondo aquí -->
 <div class="bg-[#0a0f1a] text-neutral-100 min-h-screen">



    <main class="max-w-6xl mx-auto px-4 py-8 sm:py-10">
      <!-- Enlace volver -->
      <a
        href={`${base}disenos/`}
        class="inline-flex items-center gap-1 text-sm text-neutral-400 hover:text-neutral-100 transition-colors"
      >
        <span>←</span>
        <span>Volver a galería de categorías</span>
      </a>

      <!-- Título de categoría (arriba, limpio) -->
      <header class="mt-4 mb-6">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-neutral-50">
          {categoriaData.nombre}
        </h1>
        {categoriaData.descripcion && (
          <p class="mt-2 text-sm sm:text-base text-neutral-400 max-w-2xl">
            {categoriaData.descripcion}
          </p>
        )}
      </header>

      <!-- 🔍 Buscador NUEVO: filtra por data-keywords -->
      <section class="mb-6 sm:mb-8">
        <label for="buscador-disenos" class="block text-xs font-medium text-neutral-400 mb-2">
          Buscar diseños por palabra clave (ej. "pollería", "menú", "logo", "toldo"…)
        </label>
        <div class="relative">
          <input
            id="buscador-disenos"
            type="text"
            placeholder="Escribe para filtrar la galería…"
            class="w-full px-4 py-3 rounded-full bg-neutral-900/80 border border-neutral-700 text-sm
                   text-neutral-100 placeholder:text-neutral-500 shadow-sm
                   focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500"
          />
          <span
            class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-neutral-500 text-xs"
          >
            🔍
          </span>
        </div>
      </section>

      <!-- 🧱 Masonry layout tipo Pinterest (columns) -->
      {disenosFiltrados.length === 0 ? (
        <p class="text-neutral-500 mt-10">
          Aún no has cargado diseños para esta categoría.
        </p>
      ) : (
        <section
          id="grid-disenos"
          class="columns-1 sm:columns-2 lg:columns-3 gap-4 sm:gap-5"
        >
          {disenosFiltrados.map((item) => {
            const keywords =
              (item.keywords && item.keywords.toLowerCase()) ||
              item.titulo.toLowerCase()

            return (
              <article
                class="dis-item mb-4 break-inside-avoid rounded-2xl overflow-hidden
                       bg-neutral-900/80 border border-neutral-800 shadow-lg
                       hover:shadow-2xl hover:-translate-y-1 transition-transform duration-300"
                data-keywords={keywords}
              >
                <h2 class="sr-only">
                  {item.titulo}
                </h2>

                <div class="relative">
                  <img
                    src={item.imagen}
                    alt={item.titulo}
                    loading="lazy"
                    class="w-full h-auto block object-cover"
                  />

                  <div
                    class="pointer-events-none absolute inset-0 bg-gradient-to-t
                           from-neutral-950/40 via-transparent to-neutral-900/10
                           opacity-0 hover:opacity-100 transition-opacity duration-300"
                  />
                </div>
              </article>
            )
          })}
        </section>
      )}
    </main>
  </div>

  <!-- 🔥 Script buscador por data-keywords -->
  <script is:inline>
    const buscador = document.getElementById('buscador-disenos');
    const items = document.querySelectorAll('.dis-item');

    if (buscador && items.length > 0) {
      buscador.addEventListener('input', () => {
        const q = buscador.value.trim().toLowerCase();

        items.forEach((card) => {
          const keywords = card.dataset.keywords || '';

          if (!q || keywords.includes(q)) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    }
  </script>
</Layout>

