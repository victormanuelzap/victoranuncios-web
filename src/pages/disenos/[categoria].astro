---
import '../css/base.css'
import { categorias } from '../../data/disenos'

const base = import.meta.env.BASE_URL
---

<main class="max-w-6xl mx-auto px-4 py-10">

  <h1 class="text-3xl font-extrabold text-slate-900 mb-6">
    Galería de diseños por categoría
  </h1>

  <section class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">

    {categorias.map((cat) => (
      <a
        href={`${base}disenos/${cat.slug}/`}
        class="block bg-white shadow-md overflow-hidden hover:shadow-xl transition-shadow duration-200"
      >
        <!-- Imagen -->
        <div class="aspect-[4/3] bg-slate-200 overflow-hidden">
          <img
            src={`${base}${cat.cover}`}
            alt={cat.nombre}
            loading="lazy"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
          />
        </div>

        <!-- Información -->
        <div class="p-5">
          <h2 class="text-xl font-bold text-slate-900">
            {cat.nombre}
          </h2>

          <p class="mt-1 text-sm text-slate-600">
            {cat.descripcion}
          </p>
        </div>

      </a>
    ))}

  </section>

</main>
