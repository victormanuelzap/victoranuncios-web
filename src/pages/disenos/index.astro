---
import Layout from '../../layouts/Layout.astro'
import { categorias } from '../../data/disenos'
const base = import.meta.env.BASE_URL
---

<style is:global>
  /* Forzar esquinas totalmente cuadradas */
  .card-square,
  .card-square div,
  .card-square img,
  .card-square input {
    border-radius: 0 !important;
  }
</style>
<!-- 🔥controla el ancho de los divs con max-w-[1450px] -->

<Layout title="Diseños Victor Anuncios">
  <main class="bg-[#E9EAEE]">
    <section class="max-w-[1500px] mx-auto px-4 py-8 sm:py-10">
      <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
        Galería de diseños por categoría
      </h1>

      <p class="text-slate-600 mt-2 max-w-3xl">
        Explora categorías y filtra rápidamente para encontrar ejemplos de diseño.
      </p>

      <!-- 🔍 BUSCADOR -->
      <div class="mt-6">
        <input
          id="buscador-categorias"
          type="text"
          placeholder="Buscar categorías..."
          class="w-full px-4 py-3 border border-slate-300 bg-white shadow-sm outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>

      <div
        class="mt-8 grid gap-6
               grid-cols-1
               sm:grid-cols-2
               md:grid-cols-3
               lg:grid-cols-4
               xl:grid-cols-5"
      >
        {categorias.map((cat) => (
          <a
            href={`${base}disenos/${cat.slug}/`}
            class="cat-item card-square group bg-white shadow-md overflow-hidden transition
                   hover:-translate-y-1 hover:shadow-xl"
            data-name={cat.nombre.toLowerCase()}
            data-desc={cat.descripcion.toLowerCase()}
          >
            <div class="relative h-44 bg-black overflow-hidden">
<img
    src={cat.imagen}
    alt={cat.nombre}
    class="w-full h-full object-contain"
    loading="lazy"
    decoding="async"
  />
</div>


            <div class="p-4 card-square">
              <h2 class="text-lg font-bold text-blue-800 leading-snug">
                {cat.nombre}
              </h2>
              <p class="text-slate-600 text-sm mt-1 leading-snug">
                {cat.descripcion}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>

<!-- 🔥 Script del Buscador -->
<script is:inline>
  const input = document.getElementById("buscador-categorias");
  const items = document.querySelectorAll(".cat-item");

  if (input && items.length > 0) {
    input.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();

      items.forEach((el) => {
        const name = el.dataset.name || "";
        const desc = el.dataset.desc || "";

        el.style.display = (name.includes(q) || desc.includes(q)) ? "" : "none";
      });
    });
  }
</script>
