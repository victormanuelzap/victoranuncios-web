---
import Layout from '../../layouts/Layout.astro'
import { categorias } from '../../data/disenos'
const base = import.meta.env.BASE_URL
---
<style is:global>
  /* Forzar esquinas totalmente cuadradas */
  .card-square,
  .card-square div,
  .card-square img {
    border-radius: 0 !important;
  }
</style>

<Layout title="Diseños Victor Anuncios">
  <main class="bg-[#E9EAEE] py-10">
    <section class="max-w-6xl mx-auto px-4">

      <h1 class="text-3xl font-extrabold text-slate-900 mb-6">
        Galería de diseños por categoría
      </h1>

      <!-- 🔍 BUSCADOR -->
      <input
        id="buscador-categorias"
        type="text"
        placeholder="Buscar categorías..."
        class="w-full mb-6 px-4 py-3 border rounded-lg shadow-sm"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {categorias.map((cat) => (
          <a
            href={`${base}disenos/${cat.slug}/`}
            class="cat-item card-square group bg-white shadow-md overflow-hidden transition hover:-translate-y-1 hover:shadow-xl"
            data-name={cat.nombre.toLowerCase()}
            data-desc={cat.descripcion.toLowerCase()}
          >
            <div class="relative h-48 overflow-hidden card-square">
              <img
                src={cat.imagen}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 card-square"
                alt={cat.nombre}
              />
            </div>

            <div class="p-5 card-square">
              <h2 class="text-xl font-bold text-blue-800">{cat.nombre}</h2>
              <p class="text-gray-600 text-sm mt-1">{cat.descripcion}</p>
            </div>
          </a>
        ))}
      </div>

    </section>
  </main>
</Layout>

<!-- 🔥 Script del Buscador -->
<script is:inline>
  const input = document.getElementById("buscador-categorias");
  const items = document.querySelectorAll(".cat-item");

  // Pequeña protección por si algo falla
  if (input && items.length > 0) {
    input.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();

      items.forEach((el) => {
        const name = el.dataset.name || "";
        const desc = el.dataset.desc || "";

        if (name.includes(q) || desc.includes(q)) {
          el.style.display = "";
        } else {
          el.style.display = "none";
        }
      });
    });
  }
</script>
