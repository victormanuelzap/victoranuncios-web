---
import Layout from '../../layouts/Layout.astro'
import { categorias } from '../../data/disenos'

const base = import.meta.env.BASE_URL
---

<Layout title="Diseños Victor Anuncios">
  <main class="bg-[#E9EAEE] py-10">
    <section class="max-w-6xl mx-auto px-4">

      <h1 class="text-3xl font-extrabold text-slate-900 mb-6">
        Galería de diseños por categoría
      </h1>

      <!-- GRID -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        {categorias.map((cat) => (
          <a
            href={`${base}disenos/${cat.slug}/`}
            class="group bg-white shadow-md overflow-hidden rounded-none transition hover:-translate-y-1 hover:shadow-xl"
          >
            <div class="relative h-48 overflow-hidden rounded-none">
              <img
                src={cat.imagen}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                alt={cat.nombre}
              />
            </div>

            <div class="p-5">
              <h2 class="text-xl font-bold text-blue-800">{cat.nombre}</h2>
              <p class="text-gray-600 text-sm mt-1">{cat.descripcion}</p>
            </div>

          </a>
        ))}

      </div>

    </section>
  </main>
</Layout>
