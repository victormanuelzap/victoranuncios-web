
---
const { title = "" } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>

  <body class="bg-white text-gray-800">

    <!-- HEADER SIMPLE -->
    <header class="py-4 px-6 border-b border-gray-200">
      <h1 class="text-xl font-semibold text-gray-700">
        Página alojada en Victor Anuncios
      </h1>
    </header>

    <!-- CONTENIDO DE LA PÁGINA -->
    <main class="px-4 py-8">
      <slot />
    </main>

    <!-- FOOTER SIMPLE -->
    <footer class="py-6 border-t border-gray-200 text-center text-sm text-gray-600">
      <p>Página alojada por Victor Anuncios – Arequipa</p>
      <p>© {new Date().getFullYear()} Todos los derechos reservados</p>
    </footer>

  </body>
</html>
