            </div>
        </nav>

       <!-- Social bar -->
<div class="hidden md:block fixed top-1/2 -translate-y-1/2 right-1 z-40">
  <div class="bg-primary text-white py-3 px-3 rounded-3xl shadow-lg
              flex flex-col items-center gap-3 overflow-hidden">
    <a href="https://www.instagram.com/victoranuncioss/"
       aria-label="Instagram Victor Anuncios"
       target="_blank" rel="noopener noreferrer"
       class="p-2 leading-none hover:scale-110 transition">
      <i class="bx bxl-instagram text-2xl"></i>
    </a>

    <a href="https://www.facebook.com/VictorAnuncioss"
       aria-label="Facebook Victor Anuncios"
       target="_blank" rel="noopener noreferrer"
