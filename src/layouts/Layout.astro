---
interface Props {
  title: string
  description?: string
  keywords?: string
  canonical?: string
}

const { title, description, keywords, canonical } = Astro.props
import '../css/base.css'

// 🔹 BASE URL AUTOMÁTICA (para que funcione en GitHub Pages y local)
const base = import.meta.env.BASE_URL
---

<!doctype html>
<html lang='es'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <meta name='description' content={description || "Letreros luminosos en Arequipa: diseño, fabricación e instalación por Victor Anuncios. Calidad, garantía y entrega rápida."} />
    <meta name='keywords' content={keywords || "letrero luminoso Arequipa, letreros LED Arequipa, cajas de luz Arequipa, publicidad exterior Arequipa, Victor Anuncios"} />
    <meta name='author' content='Victor Anuncios' />
    <meta name='generator' content={Astro.generator} />

    <title>{title}</title>

    <!-- Favicon y Open Graph -->
<!-- Favicon para todos los navegadores -->
<link rel="icon" type="image/x-icon" href={`${base}favicon.ico?v=1`} />

<!-- Favicon PNG (moderno) -->
<link rel="icon" type="image/png" sizes="48x48" href={`${base}favicon.png?v=1`} />

<!-- Para iPhone / iPad -->
<link rel="apple-touch-icon" sizes="180x180" href={`${base}favicon.png?v=1`} />

<!-- Para Android -->
<link rel="icon" sizes="192x192" href={`${base}favicon.png?v=1`} />


    <meta property='og:title' content={title} />
  
<meta
  property='og:description'
  content={description || 'Letreros luminosos en Arequipa — diseño, fabricación e instalación.'}
/>

    <meta property='og:type' content='website' />
    <meta property='og:locale' content='es_PE' />
    <meta property='og:image' content={`${base}og-cover.jpg`} />

    <!-- Canonical -->


<link rel='canonical' href={canonical || Astro.url.href} />


    <!-- Fuentes y librerías -->
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link href='https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap' rel='stylesheet' />
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet' />
    <link href='https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css' rel='stylesheet' />

    <!-- ✅ Estilos principales (ajustado para GitHub Pages) -->
    <link rel="stylesheet" href={`${base}_astro/entry.css`} />

    <!-- Google tag (gtag.js) -->
    <script async src='https://www.googletagmanager.com/gtag/js?id=AW-17054169407'></script>
    <script is:raw>
      window.dataLayer = window.dataLayer || [];

      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-17054169407');
    </script>
  </head>

  <body class="overflow-x-hidden">
    <!-- HEADER ESCRITORIO -->
    <div class="hidden md:block sticky top-0 z-50 bg-white border-b border-gray-200">

      <div class="container mx-auto h-24 flex items-center justify-between">

        <!-- IZQUIERDA -->
        <a href={`${base}`} class="flex items-center gap-2">
          <img src={`${base}logo.png`} class="w-14" alt="VICTOR ANUNCIOS logo" />
          <span class="hidden lg:block font-bold">VICTOR ANUNCIOS</span>
        </a>

        <!-- CENTRO -->
        <div class="flex flex-col items-center text-center">
          <div class="text-sm font-semibold text-neutral-700">
            Iluminamos tu marca en Arequipa ⚡
          </div>
          <div class="mt-1 flex flex-wrap justify-center gap-2 text-xs text-neutral-600">

<span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-purple-100 border">
  💳 Pagos: Yape • Plin • Interbank
</span>


            <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-gray-100 border">✅ Garantía 1 año</span>
            <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-gray-100 border">🛠️ Diseño + instalación</span>
            <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-gray-100 border">🚚 Entrega rápida</span>
          </div>
        </div>

        <!-- DERECHA (MENÚ ESCRITORIO) -->
<nav class="relative flex items-center gap-6 text-[17px] font-semibold text-neutral-900">

  <a href={`${base}`} class="hover:text-primary">Inicio</a>

  <!-- DROPDOWN SERVICIOS -->
  <div class="group relative">
    <button class="hover:text-primary flex items-center gap-1">
      Servicios
      <i class='bx bx-chevron-down text-xl'></i>
    </button>

    <!-- CONTENIDO DEL DROPDOWN -->
    <div class="absolute left-0 mt-2 hidden group-hover:block bg-white shadow-lg border rounded-lg py-2 w-56 z-50">

      <a href={`${base}servicios/letrero-luminoso/`}
         class="block px-4 py-2 hover:bg-gray-100">Letreros luminosos</a>

      <a href={`${base}servicios/3d/`}
         class="block px-4 py-2 hover:bg-gray-100">Letras 3D</a>

      <a href={`${base}servicios/gigantografias/`}
         class="block px-4 py-2 hover:bg-gray-100">Gigantografías</a>

      <a href={`${base}servicios/vinilos/`}
         class="block px-4 py-2 hover:bg-gray-100">Vinilos</a>

      <a href={`${base}tarjetas/`}
         class="block px-4 py-2 hover:bg-gray-100">Tarjetas personales</a>

      <a href={`${base}volantes/`}
         class="block px-4 py-2 hover:bg-gray-100">Volantes</a>

      <a href={`${base}formateria/`}
         class="block px-4 py-2 hover:bg-gray-100">Formatería</a>

      <a href={`${base}calendarios/`}
         class="block px-4 py-2 hover:bg-gray-100">Calendarios</a>

    </div>
  </div>

  <a href={`${base}contacto/`} class="hover:text-primary">Contacto</a>
</nav>


      </div>
    </div>


    <!-- HEADER MÓVIL -->
    <div class="md:hidden sticky top-0 z-50 bg-white border-b border-gray-200">
      <div class="flex items-center justify-between px-4 h-16">

<!-- LOGO + TEXTO + MEDIOS DE PAGO -->
<a href={`${base}`} class="flex items-center gap-2 min-w-0">
  <img src={`${base}logo.png`} class="h-10 w-auto flex-shrink-0" alt="Victor Anuncios" />

  <div class="flex flex-col leading-tight min-w-0">
    <span class="text-base font-bold text-neutral-900 truncate">
      VICTOR ANUNCIOS
    </span>

    <div class="flex items-center gap-1 mt-1">
      <span class="text-[11px] font-semibold text-neutral-700">
   
      </span>
     
    </div>
  </div>
</a>




        <!-- BOTÓN MENÚ -->
        <button
          type="button"
          aria-label="Abrir menú"
          class="flex flex-col gap-1"
          data-menu-toggle
        >
          <span class="w-7 h-[3px] bg-gray-900 rounded"></span>
          <span class="w-7 h-[3px] bg-gray-900 rounded"></span>
          <span class="w-7 h-[3px] bg-gray-900 rounded"></span>
        </button>
      </div>

      <!-- MENÚ DESPLEGABLE MÓVIL -->
      <div
        id="mobile-menu"
        class="hidden bg-white border-t border-gray-200 shadow-sm"
      >
<nav class="flex flex-col px-4 py-3 gap-3 text-base font-semibold text-neutral-900">
  <a href={`${base}`} class="py-1">Inicio</a>
  <a href={`${base}servicios/letrero-luminoso/`} class="py-1">Letreros luminosos</a>
  <a href={`${base}servicios/3d/`} class="py-1">Letras 3D</a>
  <a href={`${base}servicios/gigantografias/`} class="py-1">Gigantografías</a>
  <a href={`${base}servicios/vinilos/`} class="py-1">Vinilos</a>
  <a href={`${base}tarjetas/`} class="py-1">Tarjetas</a>
  <a href={`${base}volantes/`} class="py-1">Volantes</a>
  <a href={`${base}formateria/`} class="py-1">Formatería</a>
  <a href={`${base}calendarios/`} class="py-1">Calendarios</a>
  <a href={`${base}contacto/`} class="py-1">Contacto</a>
</nav>

      </div>
    </div>


      

    
    <!-- SOCIAL BAR -->
    <div class="hidden md:block fixed top-1/2 -translate-y-1/2 right-1 z-40">
      <div class="bg-primary text-white py-3 px-3 rounded-3xl shadow-lg flex flex-col items-center gap-3">
        <a href="https://www.instagram.com/victoranuncioss/" target="_blank" class="hover:scale-110 transition"><i class="bx bxl-instagram text-2xl"></i></a>
        <a href="https://www.facebook.com/VictorAnuncioss" target="_blank" class="hover:scale-110 transition"><i class="bx bxl-facebook text-2xl"></i></a>
        <a href="https://www.tiktok.com/@victor.anuncios" target="_blank" class="hover:scale-110 transition"><i class="bx bxl-tiktok text-2xl"></i></a>
      </div>
    </div>

    <slot />

    <!-- FOOTER -->
    <footer class='bg-blue-700 py-10 mt-20 md:mt-28'>
      <div class='pb-10 text-center'>
        <img src={`${base}logo.png`} class='w-20 mx-auto' alt='logo' />
        <h2 class='text-white font-bold text-2xl mt-3'>Victor Anuncios</h2>
        <p class='text-gray-200 mt-2'>Tarjetas de presentación, Letreros 3D, Cortes Laser, Gigantografías, Volantes, Imantados y Afiches.</p>


      </div>
<div class="mt-6 flex flex-col items-center gap-3">
  <p class="text-gray-100 text-sm font-semibold">
    Pagos disponibles:
  </p>

  <div class="flex items-center justify-center gap-4">
    <img src={`${base}yape.png`} class="h-10 w-auto" alt="Yape" />
    <img src={`${base}plin.png`} class="h-10 w-auto" alt="Plin" />
    <img src={`${base}interbank.webp`} class="h-10 w-auto" alt="Interbank" />
  </div>
</div>

    </footer>

    <!-- Botón WhatsApp -->
    <div class='fixed bottom-10 right-10 bg-green-500 text-white p-4 rounded-full shadow-lg cursor-pointer z-50 w-16 h-16 flex items-center justify-center'>
      <a href='https://wa.me/51946182531' target='_blank'>
        <i class='bx bxl-whatsapp text-3xl'></i>
      </a>
    </div>

 
<!-- Librería Splide (v4) -->
<script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js" is:inline></script>
<!-- Toggle menú móvil -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.querySelector('[data-menu-toggle]');
    const menu = document.querySelector('#mobile-menu');

    if (!btn || !menu) return;

    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  });
</script>


<!-- Init sin error de TS -->



<!-- Inicialización robusta SIN error TS -->




  </body>
</html>


<style is:global>
  html {
    font-family: 'Poppins', sans-serif;
  }
  .gallery img {
    width: 100%;
    object-fit: cover;
    aspect-ratio: 16 / 9;
    transition: all 0.3s ease-in-out;
  }
</style>
<style is:global>
  html, body {
    overflow-x: hidden;
    scroll-behavior: smooth;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .splide__slide img {
    width: 100%;
    height: 350px;
    object-fit: cover;
  }

  /* Espaciado entre secciones */
  section {
    margin: 0;
    padding: 0;
  }

  /* Corrige espacio blanco entre header y slider */
  .hidden.md\:block.sticky {
    margin-bottom: 0;
  }

  /* Logo controlado */
  header img, .logo img {
    max-height: 70px;
    height: auto;
  }

  /* Galería */
  .gallery img {
    width: 100%;
    object-fit: cover;
    aspect-ratio: 16/9;
    transition: all 0.3s ease-in-out;
  }
</style>
