---
interface Props {
  title: string;
  description?: string;
  keywords?: string;
  canonical?: string;
}

const { title, description, keywords, canonical } = Astro.props;

import "../css/base.css";

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>

    <meta
      name="description"
      content={
        description ||
        "Letreros luminosos en Arequipa: diseño, fabricación e instalación por Victor Anuncios."
      }
    />

    <meta
      name="keywords"
      content={
        keywords ||
        "letreros luminosos Arequipa, publicidad Arequipa, Victor Anuncios"
      }
    />

    <link rel="canonical" href={canonical || Astro.url.href} />

    <link rel="icon" href={base + "favicon.ico"} />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@splidejs/splide@3.1.4/dist/css/splide.min.css"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
      referrerpolicy="no-referrer"
    />
  </head>

  <body class="overflow-x-hidden min-h-screen flex flex-col">

    <header class="bg-blue-600 sticky top-0 z-[9999] overflow-visible">
      <div class="max-w-6xl mx-auto flex items-center justify-between px-4 py-3 overflow-visible">

        <!-- BRAND -->
        <a href={base} class="flex items-center gap-3 text-white">
          <img
            src={base + "logo.png"}
            class="w-10 h-10 object-contain"
            alt="Victor Anuncios"
          />

          <div class="leading-tight">
            <div class="font-extrabold text-lg">Victor Anuncios</div>
            <div class="text-xs opacity-90 -mt-0.5">Arequipa</div>
          </div>
        </a>

        <!-- NAV DESKTOP -->
        <nav class="hidden md:flex items-center gap-8 font-semibold text-white overflow-visible">
          <a class="hover:underline underline-offset-8" href={base}>
            Inicio
          </a>

          <!-- SERVICIOS DESPLEGABLE DESKTOP -->
          <div class="relative group">
            <button
              type="button"
              class="hover:underline underline-offset-8 flex items-center gap-2 font-semibold text-white"
            >
              Servicios
              <span class="text-sm">⌄</span>
            </button>

            <div
              class="absolute left-0 top-full pt-3 opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 z-[99999]"
            >
              <div class="bg-white text-gray-900 rounded-xl shadow-2xl border border-gray-200 w-72 py-3">
                <a
                  class="block px-6 py-3 text-lg font-extrabold hover:bg-gray-100 hover:text-red-600 transition"
                  href={base + "servicios/letrero-luminoso/"}
                >
                  Letreros luminosos
                </a>

                <a
                  class="block px-6 py-3 text-lg font-extrabold hover:bg-gray-100 hover:text-red-600 transition"
                  href={base + "servicios/3d/"}
                >
                  Letras 3D
                </a>

                <a
                  class="block px-6 py-3 text-lg font-extrabold hover:bg-gray-100 hover:text-red-600 transition"
                  href={base + "servicios/gigantografias/"}
                >
                  Gigantografías
                </a>

                <a
                  class="block px-6 py-3 text-lg font-extrabold hover:bg-gray-100 hover:text-red-600 transition"
                  href={base + "servicios/vinilos/"}
                >
                  Vinilos
                </a>

                <a
                  class="block px-6 py-3 text-lg font-extrabold hover:bg-gray-100 hover:text-red-600 transition"
                  href={base + "servicios/toldos-enrollables/"}
                >
                  Toldos enrollables
                </a>

                <a
                  class="block px-6 py-3 text-lg font-extrabold hover:bg-gray-100 hover:text-red-600 transition"
                  href={base + "tarjetas/"}
                >
                  Tarjetas personales
                </a>

                <a
                  class="block px-6 py-3 text-lg font-extrabold hover:bg-gray-100 hover:text-red-600 transition"
                  href={base + "volantes/"}
                >
                  Volantes
                </a>

                <a
                  class="block px-6 py-3 text-lg font-extrabold hover:bg-gray-100 hover:text-red-600 transition"
                  href={base + "formateria/"}
                >
                  Formatería
                </a>

                <a
                  class="block px-6 py-3 text-lg font-extrabold hover:bg-gray-100 hover:text-red-600 transition"
                  href={base + "calendarios/"}
                >
                  Calendarios
                </a>

                <a
                  class="block px-6 py-3 text-lg font-extrabold hover:bg-gray-100 hover:text-red-600 transition"
                  href={base + "servicios/paginas-web/"}
                >
                  Páginas web
                </a>

                <a
                  class="block px-6 py-3 text-lg font-extrabold hover:bg-gray-100 hover:text-red-600 transition"
                  href={base + "servicios/mochilas_publicitarias/"}
                >
                  Mochilas publicitarias
                </a>

                <a
                  class="block px-6 py-3 text-lg font-extrabold hover:bg-gray-100 hover:text-red-600 transition"
                  href={base + "servicios/rollscreens/"}
                >
                  Rollscreens
                </a>

                <a
                  class="block px-6 py-3 text-lg font-extrabold hover:bg-gray-100 hover:text-red-600 transition"
                href={base + "servicios/cinta_neon/"}
                >
                  Cintas neon
                </a>

                <a
                  class="block px-6 py-3 text-lg font-extrabold hover:bg-gray-100 hover:text-red-600 transition"
                  href={base + "disenos/"}
                >
                  Diseños
                </a>
              </div>
            </div>
          </div>

          <a class="hover:underline underline-offset-8" href={base + "contacto/"}>
            Contacto
          </a>

          <a
            class="bg-white text-blue-700 font-extrabold px-4 py-2 rounded-lg hover:opacity-90"
            href={"https://wa.me/51" + "946182531" + "?text=" + encodeURIComponent("Hola, quiero una cotización")}
            target="_blank"
            rel="noopener"
          >
            Cotizar Ahora
          </a>
        </nav>

        <!-- BOTÓN HAMBURGUESA SOLO MÓVIL -->
        <button
          id="menuBtn"
          class="md:hidden text-white text-3xl leading-none relative z-[60]"
          aria-label="Abrir menú"
          type="button"
        >
          ☰
        </button>
      </div>

      <!-- MENÚ MÓVIL -->
      <div id="mobileMenu" class="md:hidden hidden bg-blue-700 border-t border-white/10 relative z-[60]">
        <nav class="flex flex-col p-4 space-y-3 font-semibold text-white">
          <a href={base}>Inicio</a>
          <a href={base + "servicios/letrero-luminoso/"}>Letreros luminosos</a>
          <a href={base + "servicios/3d/"}>Letras 3D</a>
          <a href={base + "servicios/gigantografias/"}>Gigantografías</a>
          <a href={base + "servicios/vinilos/"}>Vinilos</a>
          <a href={base + "servicios/toldos-enrollables/"}>Toldos enrollables</a>
          <a href={base + "tarjetas/"}>Tarjetas personales</a>
          <a href={base + "volantes/"}>Volantes</a>
          <a href={base + "formateria/"}>Formatería</a>
          <a href={base + "servicios/calendarios/"}>Calendarios</a>
          <a href={base + "servicios/paginas-web/"}>Páginas web</a>
          <a href={base + "servicios/mochilas_publicitarias/"}>Mochilas publicitarias</a>
          <a href={base + "servicios/rollscreens/"}>Rollscreens</a>
         <a href={base + "servicios/cinta_neon/"}>Cintas neon</a>
          <a href={base + "disenos/"}>Diseños</a>
          <a href={base + "contacto/"}>Contacto</a>

          <a
            class="mt-2 bg-white text-blue-700 font-extrabold px-4 py-3 rounded-lg text-center"
            href={"https://wa.me/51" + "946182531" + "?text=" + encodeURIComponent("Hola, quiero una cotización")}
            target="_blank"
            rel="noopener"
          >
            Cotizar Ahora
          </a>
        </nav>
      </div>
    </header>

    <!-- CONTENIDO -->
    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-[#0B1220] text-white">
      <div class="max-w-6xl mx-auto px-6 py-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-14">

          <!-- Col 1 -->
          <div>
            <div class="flex items-center gap-3">
              <img
                src={base + "logo.png"}
                class="w-10 h-10 object-contain"
                alt="Victor Anuncios"
              />

              <div class="leading-tight">
                <div class="font-extrabold text-lg text-white">Victor Anuncios</div>
                <div class="text-sm text-slate-300/80 -mt-0.5">Arequipa</div>
              </div>
            </div>

            <p class="mt-4 text-[15px] text-slate-300/80 leading-7 max-w-[320px]">
              Especialistas en publicidad exterior, letreros luminosos LED, letras 3D corpóreas y material impreso de alta calidad en Arequipa, Perú.
            </p>
          </div>

          <!-- Col 2 -->
          <div>
            <div class="font-extrabold text-lg mb-4 text-white">Contacto</div>

            <div class="space-y-3 text-[15px] text-slate-300/80">
              <a class="group flex items-start gap-3 hover:text-white transition" href="tel:+51946182531">
                <i class="fa-solid fa-phone mt-[2px] text-slate-300 group-hover:text-white transition"></i>
                <span>946 182 531</span>
              </a>

              <a class="group flex items-start gap-3 hover:text-white transition" href="mailto:victoranuncioss@gmail.com">
                <i class="fa-solid fa-envelope mt-[2px] text-slate-300 group-hover:text-white transition"></i>
                <span>victoranuncioss@gmail.com</span>
              </a>

              <a class="group flex items-start gap-3 hover:text-white transition" href="#">
                <i class="fa-solid fa-location-dot mt-[2px] text-slate-300 group-hover:text-white transition"></i>
                <span>Av. Ramón Castilla 1004, Cayma Bolognesi, Arequipa</span>
              </a>
            </div>
          </div>

          <!-- Col 3 -->
          <div>
            <div class="font-extrabold text-lg mb-4 text-white">Servicios</div>

            <div class="space-y-2 text-[15px] text-slate-300/80">
              <a class="block hover:text-white transition" href={base + "servicios/letrero-luminoso/"}>Letreros Luminosos</a>
              <a class="block hover:text-white transition" href={base + "servicios/3d/"}>Letras 3D</a>
              <a class="block hover:text-white transition" href={base + "servicios/gigantografias/"}>Gigantografías</a>
              <a class="block hover:text-white transition" href={base + "servicios/vinilos/"}>Vinilos Adhesivos</a>
              <a class="block hover:text-white transition" href={base + "tarjetas/"}>Tarjetas Personales</a>
            </div>
          </div>

          <!-- Col 4 -->
          <div>
            <div class="font-extrabold text-lg mb-4 text-white">Síguenos</div>

            <div class="flex items-center gap-3">
  <a
    class="w-12 h-12 rounded-xl bg-[#1877F2] flex items-center justify-center hover:brightness-110 transition"
    href="https://www.facebook.com/VictorAnunciosarequipa"
    target="_blank"
    rel="noopener"
    aria-label="Facebook"
  >
    <i class="fa-brands fa-facebook-f text-white text-lg"></i>
  </a>

  <a
    class="w-12 h-12 rounded-xl bg-black flex items-center justify-center hover:brightness-110 transition"
    href="https://www.tiktok.com/@victor.anuncios"
    target="_blank"
    rel="noopener"
    aria-label="TikTok"
  >
    <i class="fa-brands fa-tiktok text-white text-lg"></i>
  </a>
</div>
            <div class="font-extrabold text-lg mt-6 mb-2 text-white">Horario de Atención</div>

            <div class="text-[15px] text-slate-300/80 leading-relaxed">
              <div>Lunes a Viernes: 9:00 AM - 6:00 PM</div>
              <div>Sábados: 9:00 AM - 1:00 PM</div>
            </div>
          </div>
        </div>

        <div class="mt-10 pt-6 border-t border-white/10 flex flex-col md:flex-row gap-4 items-start md:items-center justify-between text-[15px] text-slate-300/80">
          <div>© 2026 Victor Anuncios. Todos los derechos reservados.</div>

          <div class="flex gap-6">
            <a class="hover:text-white transition" href={base + "terminos/"}>Términos y Condiciones</a>
            <a class="hover:text-white transition" href={base + "privacidad/"}>Política de Privacidad</a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const btn = document.getElementById("menuBtn");
        const menu = document.getElementById("mobileMenu");

        if (!btn || !menu) return;

        btn.addEventListener("click", () => {
          menu.classList.toggle("hidden");
        });

        menu.querySelectorAll("a").forEach((a) => {
          a.addEventListener("click", () => {
            menu.classList.add("hidden");
          });
        });
      });
    </script>
  </body>
</html>
