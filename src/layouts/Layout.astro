---
interface Props {
  title: string;
  description?: string;
  keywords?: string;
  canonical?: string;
}

const { title, description, keywords, canonical } = Astro.props;

import "../css/base.css";

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>

    <meta
      name="description"
      content={
        description ||
        "Letreros luminosos en Arequipa: diseño, fabricación e instalación por Victor Anuncios."
      }
    />

    <meta
      name="keywords"
      content={
        keywords ||
        "letreros luminosos Arequipa, publicidad Arequipa, Victor Anuncios"
      }
    />

    <link rel="canonical" href={canonical || Astro.url.href} />

    <link rel="icon" href={base + "favicon.ico"} />

  </head>

  <body class="overflow-x-hidden">

    <!-- HEADER -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <div class="container mx-auto flex items-center justify-between h-20 px-4">
        <a href={base} class="flex items-center gap-2">
          <img src={base + "logo.png"} class="w-12" alt="Victor Anuncios" />
          <span class="font-bold text-lg">VICTOR ANUNCIOS</span>
        </a>

        <nav class="hidden md:flex gap-6 font-semibold">
          <a href={base}>Inicio</a>
          <a href={base + "contacto/"}>Contacto</a>
        </nav>
      </div>
    </header>

    <!-- CONTENIDO -->
    <slot />

    <!-- FOOTER -->
    <footer class="bg-[#0B1A2D] py-14 mt-20">
      <div class="max-w-4xl mx-auto text-center px-6">
        <img
          src={base + "logo.png"}
          class="w-24 mx-auto mb-4"
          alt="Victor Anuncios"
        />

        <h2 class="text-white font-bold text-2xl mb-2">
          Victor Anuncios
        </h2>

        <p class="text-gray-300 text-sm">
          Letreros luminosos, Gigantografías, Vinilos y Diseño en Arequipa.
        </p>

        <p class="text-gray-400 text-xs mt-6">
          © 2026 Victor Anuncios. Todos los derechos reservados.
        </p>
      </div>
    </footer>

  </body>
</html>
