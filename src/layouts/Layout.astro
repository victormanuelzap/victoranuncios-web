---
interface Props {
  title: string
  description?: string
  keywords?: string
  canonical?: string
}

const { title, description, keywords, canonical } = Astro.props
import '../css/base.css'
---

<!doctype html>
<html lang='en'>
    <head>
       <meta charset="UTF-8" />
<meta name="description" content="Letreros luminosos en Arequipa: diseño, fabricación e instalación por Victor Anuncios. Calidad, garantía y entrega rápida." />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<!-- Usa tu logo.png como favicon (correcto para PNG) -->


<link rel="icon" type="image/png" href="/logo.png?v=7" />


<meta name="generator" content={Astro.generator} />
<title>{title}</title>

<meta name="keywords" content="letrero luminoso Arequipa, letreros LED Arequipa, cajas de luz Arequipa, publicidad exterior Arequipa, Victor Anuncios" />
<meta name="author" content="Victor Anuncios" />

<!-- Open Graph / Redes -->
<meta property="og:title" content={title} />
<meta property="og:description" content="Letreros luminosos en Arequipa — diseño, fabricación e instalación." />
<meta property="og:type" content="website" />
<meta property="og:locale" content="es_PE" />
<meta property="og:image" content="/og-cover.jpg" /> <!-- opcional si tienes una imagen -->

<!-- Canonical -->
<link rel="canonical" href={Astro.url.href} />

        <link rel='preconnect' href='https://fonts.googleapis.com' />
        <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
        <link
            href='https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap'
            rel='stylesheet'
        />
        <link
            href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css'
            rel='stylesheet'
        />
        <link
            href='https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css'
            rel='stylesheet'
        />
        <!-- Google tag (gtag.js) -->
        <script
            async
            src='https://www.googletagmanager.com/gtag/js?id=AW-17054169407'
        ></script>
        <script is:raw>
            window.dataLayer = window.dataLayer || []
            function gtag() {
                dataLayer.push(arguments)
            }
            gtag('js', new Date())
            gtag('config', 'AW-17054169407')
        </script>
    </head>
    <body class="overflow-x-hidden">
      


<!-- HEADER CON MENSAJE EN EL CENTRO -->
<div class="hidden md:block sticky top-0 z-50 bg-white border-b border-gray-200">
  <div class="container mx-auto h-24 grid grid-cols-12 items-center gap-4">

<!-- IZQUIERDA: Logo (totalmente pegado al borde) -->
<a href="/"
   class="col-span-3 justify-self-start -ml-8 md:-ml-10 flex items-center gap-2 font-bold text-neutral-900">
  <img src="/logo.png" class="w-14" alt="VICTOR ANUNCIOS logo" />
  <span class="hidden lg:block">VICTOR ANUNCIOS</span>
</a>


    <!-- CENTRO: Mensaje + badges -->
    <div class="col-span-5 flex flex-col items-center justify-center text-center">
      <div class="text-sm font-semibold text-neutral-700">
        Iluminamos tu marca en Arequipa ⚡
      </div>
      <div class="mt-1 flex flex-wrap justify-center gap-2 text-xs text-neutral-600">
        <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-gray-100 border">
          ✅ Garantía 1 año
        </span>
        <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-gray-100 border">
          🛠️ Diseño + instalación
        </span>
        <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-gray-100 border">
          🚚 Entrega rápida
        </span>
      </div>
    </div>

    <!-- DERECHA: Menú con líneas divisoras -->
    <nav class="col-span-4 flex items-center justify-end text-[17px] font-semibold text-neutral-900 divide-x divide-gray-300">
      <a href="/"           class="px-4 hover:text-primary transition-colors">Inicio</a>
      <a href="/#productos" class="px-4 hover:text-primary transition-colors">Productos</a>
      <a href="/#servicios" class="px-4 hover:text-primary transition-colors">Servicios</a>
      <a href="/contacto"   class="px-4 hover:text-primary transition-colors">Contacto</a>
    </nav>

  </div>
</div>






        <nav class='bg-primary text-white sticky top-0 w-full z-50 md:hidden'>
