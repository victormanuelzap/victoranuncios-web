<style is:global>
    html {
        font-family: 'Poppins', sans-serif;
    }

    .divider {
        border: 0;
        height: 2px;
        background: #ffff;
        margin: 10px 0;
    }

    .gallery img {
        width: 100%;
        height: auto;
        object-fit: cover;
        transition: all 0.3s ease-in-out;
        aspect-ratio: 16 / 9;
    }
</style>
